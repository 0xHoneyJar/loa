  "properties": {
    "hunks": {"type": "object", "additionalProperties": false,
              "patternProperties": {"^H[0-9]{2,}$": {"$ref": "#/$defs/hunk"}}},
    "incidents": {"type": "object", "additionalProperties": false,
                  "patternProperties": {"^I[0-9]{2,}$": {"$ref": "#/$defs/incident"}}}
