    "group": {"anyOf": [{"type": "string", "pattern": "^D[0-9]+$"}, {"type": "null"}]},
    "severity": {"enum": ["critical", "high", "medium", "low", null]},
    "hunk": {"type": "object", "required": ["verdict", "group", "file", "anchor_lines", "description", "severity", "category"],
