                            "group": {"$ref": "#/$defs/group"}, "file": {"type": ["string", "null"]},
                            "anchor_lines": {"$ref": "#/$defs/anchors"}, "description": {"type": ["string", "null"]},
                            "severity": {"$ref": "#/$defs/severity"}, "category": {"type": ["string", "null"]}}},
    "incident": {"type": "object", "required": ["verdict", "group", "file", "anchor_lines", "description", "severity"],
