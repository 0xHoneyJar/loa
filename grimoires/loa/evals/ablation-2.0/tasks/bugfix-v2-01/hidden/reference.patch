diff -ruN a/tests/test_regressions.py b/tests/test_regressions.py
--- a/tests/test_regressions.py
+++ b/tests/test_regressions.py
@@ -0,0 +1,45 @@
+from stockroom import Inventory, Item
+
+
+def make():
+    inv = Inventory()
+    inv.add(Item("A1", "Bolt", "hardware", 10, ("metal",)))
+    inv.add(Item("C3", "Glue", "supplies", 2))
+    inv.find("bolt")
+    inv.counts()
+    return inv
+
+
+def test_remove_frees_the_name():
+    inv = make()
+    inv.remove("A1")
+    assert inv.find("bolt") is None and inv.with_tag("metal") == []
+    inv.add(Item("A2", "bolt", "hardware"))
+    assert inv.find("BOLT").sku == "A2"
+
+
+def test_summary_follows_a_move():
+    inv = make()
+    inv.move("C3", "hardware")
+    assert inv.counts() == {"hardware": 2}
+
+
+def test_batch_lookups_and_single_revision():
+    inv = make()
+    start = inv.revision
+    with inv.batch():
+        inv.add(Item("D4", "Saw", "tools"))
+        assert inv.find("saw").sku == "D4"
+        inv.remove("D4")
+        assert inv.find("saw") is None
+    assert inv.revision == start + 1
+
+
+def test_no_op_changes_keep_revision_and_caches():
+    inv = make()
+    before = (inv.revision, inv.index.rebuilds, inv.summary.rebuilds)
+    inv.move("A1", "hardware")
+    inv.restock("A1", 0)
+    inv.find("bolt")
+    inv.counts()
+    assert (inv.revision, inv.index.rebuilds, inv.summary.rebuilds) == before
