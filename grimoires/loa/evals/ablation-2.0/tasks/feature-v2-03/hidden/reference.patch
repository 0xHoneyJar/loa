+    def run(self, data, *, checkpoint=None, resume=False):
+        """Feed ``data`` through every step; the last step's output.
+
+        With ``checkpoint`` the completed steps are recorded after each one; with
+        ``resume`` the leading steps whose recorded input matches are reused.
+        """
+        if resume and checkpoint is None:
+            raise ValueError("resume needs a checkpoint")
+        self.last_run = []
+        if checkpoint is None:
+            for name, function in self.steps:
+                data = function(data)
+                self.last_run.append((name, "ran"))
+            return data
+        old = []
+        if resume and os.path.exists(checkpoint):
+            old = ckpt.load(checkpoint, self.names())
+        elif not resume and os.path.lexists(checkpoint):
+            os.unlink(checkpoint)
+        done = []
+        reusing = True
+        for index, (name, function) in enumerate(self.steps):
+            reusing = reusing and index < len(old) and old[index]["input"] == ckpt.digest(data)
+            if reusing:
+                done.append(old[index])
+                data = old[index]["output"]
+                self.last_run.append((name, "reused"))
+            else:
+                output = function(data)
+                done.append(ckpt.entry(name, data, output))
+                data = output
+                self.last_run.append((name, "ran"))
+            ckpt.save(checkpoint, done)
         return data
