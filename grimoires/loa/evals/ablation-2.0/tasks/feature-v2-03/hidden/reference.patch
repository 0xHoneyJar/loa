diff -ruN a/src/stagerun/checkpoint.py b/src/stagerun/checkpoint.py
--- a/src/stagerun/checkpoint.py
+++ b/src/stagerun/checkpoint.py
@@ -0,0 +1,65 @@
+"""Checkpoint files: ``{"version": 1, "steps": [{"name", "input", "output"}, ...]}``."""
+import hashlib
+import json
+import re
+
+from .errors import CheckpointError
+from .store import write_json
+
+_DIGEST = re.compile(r"[0-9a-f]{64}")
+
+
+def digest(value):
+    """Lowercase hex SHA-256 of the canonical JSON of ``value``."""
+    text = json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+
+def _valid_entry(entry):
+    return (
+        isinstance(entry, dict)
+        and set(entry) == {"name", "input", "output"}
+        and isinstance(entry["name"], str)
+        and isinstance(entry["input"], str)
+        and _DIGEST.fullmatch(entry["input"]) is not None
+    )
+
+
+def load(path, names):
+    """The checked entries of the checkpoint at ``path`` for a pipeline with step ``names``."""
+    try:
+        with open(path, "rb") as fh:
+            doc = json.loads(fh.read().decode("utf-8"))
+    except (UnicodeDecodeError, ValueError):
+        raise CheckpointError("corrupt checkpoint: not JSON") from None
+    if not isinstance(doc, dict):
+        raise CheckpointError("corrupt checkpoint: not an object")
+    version = doc.get("version")
+    if type(version) is not int or version != 1:
+        raise CheckpointError(f"corrupt checkpoint: unsupported version {version!r}")
+    entries = doc.get("steps")
+    if not isinstance(entries, list):
+        raise CheckpointError("corrupt checkpoint: steps is not a list")
+    for number, entry in enumerate(entries, start=1):
+        if not _valid_entry(entry):
+            raise CheckpointError(f"corrupt checkpoint: bad entry {number}")
+    if len(entries) > len(names):
+        raise CheckpointError(f"checkpoint has {len(entries)} steps, pipeline has {len(names)}")
+    for number, (entry, name) in enumerate(zip(entries, names), start=1):
+        if entry["name"] != name:
+            raise CheckpointError(f"checkpoint step {number} is {entry['name']!r}, pipeline step {number} is {name!r}")
+    return entries
+
+
+def save(path, entries):
+    """Rewrite the checkpoint atomically with ``entries``."""
+    write_json(path, {"version": 1, "steps": entries})
+
+
+def entry(name, step_input, output):
+    """A checkpoint entry; CheckpointError when ``output`` is not JSON-serialisable."""
+    try:
+        json.dumps(output)
+    except (TypeError, ValueError):
+        raise CheckpointError(f"step {name!r} output is not JSON-serialisable") from None
+    return {"name": name, "input": digest(step_input), "output": output}
