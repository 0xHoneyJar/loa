diff -ruN a/src/permit/paths.py b/src/permit/paths.py
--- a/src/permit/paths.py
+++ b/src/permit/paths.py
@@ -15,3 +15,19 @@
 def segments(path):
     """The segments of a normalised path; the root has none."""
     return [p for p in normalize(path).split("/") if p]
+
+
+def pattern_matches(pattern, parts):
+    """Does the normalised ``pattern`` (``*`` one segment, a final ``**`` any rest) match path segments ``parts``?"""
+    want = [p for p in pattern.split("/") if p]
+    if want and want[-1] == "**":
+        head = want[:-1]
+        return len(parts) >= len(head) and all(w == "*" or w == p for w, p in zip(head, parts))
+    return len(parts) == len(want) and all(w == "*" or w == p for w, p in zip(want, parts))
+
+
+def specificity(pattern):
+    """A sort key; larger is more specific: literal segments, then no ``**``, then fewer ``*``."""
+    want = [p for p in pattern.split("/") if p]
+    literal = sum(1 for p in want if p not in ("*", "**"))
+    return (literal, "**" not in want, -want.count("*"))
