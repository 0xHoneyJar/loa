         return rule.principal == user
 
+    def _matching(self, rules, user, action, parts):
+        return [
+            rule for rule in rules
+            if self._principal_matches(rule, user)
+            and rule.action in ("*", action)
+            and pattern_matches(rule.path, parts)
+        ]
+
+    def explain(self, user, action, path):
+        """The decision for ``user`` doing ``action`` on ``path`` and the rule that decided it."""
+        parts = segments(path)
