+"""Grouping and aggregates.
+
+--group-by KEY[,KEY2] groups rows by one or two fields, in order of first
+appearance; --agg count|sum:FIELD|min:FIELD|max:FIELD adds one column per
+group (headers count, sum(FIELD), min(FIELD), max(FIELD)). sum, min and max
+skip empty cells and require numeric ones; a group with no filled cell gets
+the empty string.
+"""
+
+from decimal import Decimal
+
+from .errors import UsageError
+from .model import Table
+from .numbers import is_numeric, to_decimal
+
+FUNCTIONS = ("sum", "min", "max")
+COUNT = ("count", None)
+
+
+def parse_group_by(value):
+    keys = value.split(",")
+    if not 1 <= len(keys) <= 2 or any(not key for key in keys) or len(set(keys)) != len(keys):
+        raise UsageError(f"invalid --group-by value: {value}")
+    return keys
+
+
+def parse_agg(value):
+    if value == "count":
+        return COUNT
+    func, sep, field = value.partition(":")
+    if not sep or func not in FUNCTIONS or not field:
+        raise UsageError(f"invalid --agg value: {value}")
+    return func, field
+
+
+def header(spec):
+    func, field = spec
+    return func if field is None else f"{func}({field})"
+
+
+def _numbers(table, members, field):
+    """(value, cell) for every filled cell of `field`; a non-numeric cell is an error."""
+    i = table.index(field)
+    values = []
+    for line, row in members:
+        cell = row[i]
+        if cell == "":
+            continue
+        if not is_numeric(cell):
+            raise UsageError(f"field {field} is not numeric: {cell} (line {line})")
+        values.append((to_decimal(cell), cell))
+    return values
+
+
+def _aggregate(table, members, spec):
+    func, field = spec
+    if func == "count":
+        return str(len(members))
+    values = _numbers(table, members, field)
+    if not values:
+        return ""
+    if func == "sum":
+        return str(sum((value for value, _ in values), Decimal(0)))
+    pick = min if func == "min" else max
+    return pick(values, key=lambda pair: pair[0])[1]
+
+
+def group(table, keys, specs, lines):
+    """One row per group: the key values, then the aggregates. `lines` maps id(row) to its line."""
+    positions = [table.index(key) for key in keys]
+    for _, field in specs:
+        if field is not None:
+            table.index(field)
+    groups = {}
+    for row in table.rows:
+        key = tuple(row[i] for i in positions)
+        groups.setdefault(key, []).append((lines[id(row)], row))
+    columns = list(keys) + [header(spec) for spec in specs]
+    rows = [list(key) + [_aggregate(table, members, spec) for spec in specs]
+            for key, members in groups.items()]
+    return Table(columns, rows)
