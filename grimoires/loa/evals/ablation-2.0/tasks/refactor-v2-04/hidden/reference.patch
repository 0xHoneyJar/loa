diff -ruN a/src/shipflow/status.py b/src/shipflow/status.py
--- a/src/shipflow/status.py
+++ b/src/shipflow/status.py
@@ -0,0 +1,21 @@
+"""The shipment status vocabulary: the one place its words appear."""
+import enum
+
+
+class Status(enum.Enum):
+    """Lifecycle order; the values are the words used in storage and reports."""
+
+    PENDING = "pending"
+    PACKED = "packed"
+    SHIPPED = "shipped"
+    DELIVERED = "delivered"
+    RETURNED = "returned"
+    CANCELLED = "cancelled"
+
+    @classmethod
+    def parse(cls, value):
+        """The member whose value is ``value``; ValueError naming the value otherwise."""
+        try:
+            return cls(value)
+        except ValueError:
+            raise ValueError(f"unknown status: {value!r}") from None
