@@ -0,0 +1,53 @@
+"""Plain data: tasks, graphs, schedule slots and their enums."""
+
+import enum
+from dataclasses import dataclass
+
+__all__ = ["Command", "Graph", "Slot", "Task", "Unit"]
+
+
+class Unit(enum.Enum):
+    """A duration unit; a bare number is minutes."""
+
+    MINUTES = "m"
+    HOURS = "h"
+
+
+class Command(enum.Enum):
+    """A command-line action."""
+
+    ORDER = "order"
+    LEVELS = "levels"
+    CRITICAL = "critical"
+    SCHEDULE = "schedule"
+    CHECK = "check"
+    SLACK = "slack"
+    DOT = "dot"
+
+
+@dataclass(frozen=True, slots=True)
+class Task:
+    """One task: its duration in minutes, its dependencies and priority."""
+
+    name: str
+    duration: int
+    needs: tuple[str, ...] = ()
+    priority: int = 0
+    line: int = 0
+
+
+@dataclass(frozen=True, slots=True)
+class Graph:
+    """The tasks of a manifest in definition order."""
+
+    tasks: tuple[Task, ...]
+
+
+@dataclass(frozen=True, slots=True)
+class Slot:
+    """One task placed on a worker."""
+
+    name: str
+    start: int
