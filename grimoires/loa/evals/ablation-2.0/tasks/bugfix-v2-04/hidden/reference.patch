 def run_batch(pool, ledger, journal, items, owner="batch"):
     """Apply ``items`` in order while holding every account they touch.
 
-    Returns a ``Report``.  A refused item ends the batch.
+    Returns a ``Report``.  The batch is all-or-nothing: a refused item undoes
+    every balance change and every journal record this batch made, and the
+    report says ``rolled back``.  The lease is released however the call ends;
+    a lease that cannot be taken raises ``ResourceBusy`` before anything
+    changes.
     """
     items = list(items)
     report = Report()
     accounts = sorted({item.account for item in items})
-    for account in accounts:
-        pool.acquire(account, owner)
-    for item in items:
-        try:
-            outcome = apply_item(ledger, journal, item)
-        except LedgerError as exc:
-            report.fail(item.id, str(exc))
-            return report
-        report.note(item.id, outcome)
-    for item_id in report.applied:
-        journal.record(item_id)
-    for account in accounts:
-        pool.release(account, owner)
+    with pool.lease(accounts, owner):
+        before = ledger.snapshot()
+        for item in items:
+            try:
+                outcome = apply_item(ledger, journal, item)
+            except LedgerError as exc:
+                ledger.restore(before)
+                for item_id in report.applied:
+                    journal.forget(item_id)
+                report.roll_back(item.id, str(exc))
+                return report
+            report.note(item.id, outcome)
