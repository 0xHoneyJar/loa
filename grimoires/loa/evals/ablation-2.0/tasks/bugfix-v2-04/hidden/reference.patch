diff -ruN a/src/batchkit/ledger.py b/src/batchkit/ledger.py
--- a/src/batchkit/ledger.py
+++ b/src/batchkit/ledger.py
@@ -28,3 +28,11 @@
     def balances(self):
         """A copy of every balance."""
         return dict(self._balances)
+
+    def snapshot(self):
+        """An opaque copy of the balances, for ``restore``."""
+        return dict(self._balances)
+
+    def restore(self, snapshot):
+        """Put every balance back as it was when ``snapshot`` was taken."""
+        self._balances = dict(snapshot)
