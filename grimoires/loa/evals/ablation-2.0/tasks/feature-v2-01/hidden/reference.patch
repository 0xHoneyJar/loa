+"""The filter registry.
 
-from .errors import RegistryError
-from .model import Filter
+The registry is built from three sources in order: the built-in filters, the
+config file, the command line. Within a source, definitions come first and
+removals second; a later definition of a name replaces an earlier one.
+"""
+
+import re
+
+from .errors import ConfigError, RegistryError
+from .model import COMMAND_LINE, CONFIG, Filter
 from .primitives import PRIMITIVES
 
+_NAME = re.compile(r"[a-z][a-z0-9_-]{0,31}")
+_DEFINE = re.compile(r"([^=,\s]+)=([^=,\s]+(?:,[^=,\s]+)*)")
+
 
 class Registry:
     """Filters by name."""
@@ -32,3 +42,50 @@
 
     def entries(self):
         return [self._filters[name] for name in self.names()]
+
+    def define(self, name, step_names, source, error=RegistryError):
+        """Register `name` as the built-in steps `step_names`, replacing any earlier filter."""
+        if not isinstance(name, str) or not _NAME.fullmatch(name):
+            raise error(f"invalid filter name: {name}")
+        funcs = []
+        for step in step_names:
+            if step not in PRIMITIVES:
+                raise error(f"unknown step {step} in {name}")
+            funcs.append(PRIMITIVES[step][0])
+        description = f"{' | '.join(step_names)} [{source}]"
+        self._filters[name] = Filter(name, tuple(funcs), description, source)
+
+    def undefine(self, name, error=RegistryError):
+        if name not in self._filters:
+            raise error(f"unknown filter: {name}")
+        del self._filters[name]
+
+
+def parse_define(value):
+    """Split a --define value `NAME=STEP[,STEP...]` into (name, steps)."""
+    match = _DEFINE.fullmatch(value)
+    if not match:
+        raise RegistryError(f"invalid --define value: {value}")
+    return match.group(1), match.group(2).split(",")
+
+
+def build_registry(config, defines=(), undefines=()):
+    """The complete registry: built-ins, then the config file, then the command line."""
+    registry = Registry.with_builtins()
+    for name, steps in config.filters:
+        registry.define(name, steps, CONFIG, error=ConfigError)
+    for name in config.disable:
+        registry.undefine(name, error=ConfigError)
+    seen = set()
+    for value in defines:
+        name, steps = parse_define(value)
+        if name in seen:
+            raise RegistryError(f"duplicate definition of {name} on the command line")
+        seen.add(name)
+        registry.define(name, steps, COMMAND_LINE)
+    for name in undefines:
+        registry.undefine(name)
+    for name in config.apply:
+        if name not in registry:
+            raise ConfigError(f"unknown filter: {name}")
+    return registry
