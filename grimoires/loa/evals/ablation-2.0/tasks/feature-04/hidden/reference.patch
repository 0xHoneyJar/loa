+def _md_escape(text):
+    return text.replace("\r\n", " ").replace("\n", " ").replace("\r", " ").replace("|", "\\|")
+
+
+def _md_pad(text, width, align):
+    if align == "center":
+        left = (width - len(text)) // 2
+        return " " * left + text + " " * (width - len(text) - left)
+    return _pad(text, width, align)
+
+
+def _md_rule(width, align):
+    if align == "right":
+        return "-" * (width - 1) + ":"
+    if align == "center":
+        return ":" + "-" * (width - 2) + ":"
+    return ":" + "-" * (width - 1)
+
+
