 """What may happen to a job next."""
+from .status import Status
+
+_TERMINAL = frozenset({Status.DONE, Status.FAILED})
+_NEXT = {Status.PENDING: ("start", "cancel"), Status.RUNNING: ("finish",), Status.FAILED: ("resubmit",)}
 
 
 def is_terminal(job: dict) -> bool:
-    return job["status"] == "done" or job["status"] == "failed"
