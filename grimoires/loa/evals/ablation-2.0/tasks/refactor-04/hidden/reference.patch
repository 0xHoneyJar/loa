diff -ruN a/src/jobboard/status.py b/src/jobboard/status.py
--- a/src/jobboard/status.py
+++ b/src/jobboard/status.py
@@ -0,0 +1,14 @@
+"""Job statuses."""
+import enum
+
+
+class Status(str, enum.Enum):
+    """A job's status; members compare equal to (and serialise as) their plain string values."""
+
+    PENDING = "pending"
+    RUNNING = "running"
+    DONE = "done"
+    FAILED = "failed"
+
+    def __str__(self) -> str:
+        return self.value
