+"""Rules files: one glob rule per line (blank lines and ``#`` comments skipped).
+
+``!`` negates, a trailing ``/`` restricts a rule to directories, and a ``/``
+anywhere else anchors the pattern to the directory the file applies to;
+an unanchored pattern matches the last segment of a path at any depth.  A
+line is brace-expanded after its ``!`` is removed; each expansion becomes
+one rule sharing the line's source, number, text and negation.
+"""
+from .braces import expand
+from .errors import BraceError, GlobError, RuleError
+from .glob import Glob
+
+
+class Rule:
+    __slots__ = ("source", "line", "text", "negated", "dir_only", "anchored", "pattern", "base",
+                 "_globs")
+
+    def __init__(self, source, line, text, negated, dir_only, anchored, pattern, base=""):
+        self.source = source
+        self.line = line
+        self.text = text
+        self.negated = negated
+        self.dir_only = dir_only
+        self.anchored = anchored
+        self.pattern = pattern
+        self.base = base
+        self._globs = {}
+
+    def _glob(self, casefold):
+        glob = self._globs.get(casefold)
+        if glob is None:
+            glob = self._globs[casefold] = Glob(self.pattern, casefold)
+        return glob
+
+    def matches(self, path, is_dir, casefold=False):
+        if self.base:
+            prefix = self.base + "/"
+            if not path.startswith(prefix):
+                return False
+            rel = path[len(prefix):]
+        else:
+            rel = path
+        if self.dir_only and not is_dir:
+            return False
+        target = rel if self.anchored else rel.rsplit("/", 1)[-1]
+        return self._glob(casefold).match(target)
+
+    def __repr__(self):
+        return f"Rule({self.source!r}, {self.line!r}, {self.text!r})"
+
+
+def _strip_trailing_spaces(line):
+    while line.endswith(" "):
+        body = line[:-1]
+        run = len(body) - len(body.rstrip("\\"))
+        if run % 2 == 1:
+            break
+        line = body
+    return line
+
+
+def _make_rule(source, number, line, negated, pattern, base):
+    dir_only = pattern.endswith("/")
+    pattern = pattern.rstrip("/")
+    if not pattern:
+        raise RuleError(f"{source}:{number}: empty pattern")
+    anchored = "/" in pattern
+    if pattern.startswith("/"):
+        pattern = pattern[1:]
+    try:
+        Glob(pattern)
+    except GlobError as exc:
+        raise RuleError(f"{source}:{number}: {exc}") from None
+    return Rule(source, number, line, negated, dir_only, anchored, pattern, base)
+
+
+def parse_rules(text, source, base=""):
+    rules = []
+    for number, raw in enumerate(text.split("\n"), 1):
+        if raw.endswith("\r"):
+            raw = raw[:-1]
+        line = _strip_trailing_spaces(raw)
+        if not line or line.startswith("#"):
+            continue
+        rest = line
+        negated = rest.startswith("!")
+        if negated:
+            rest = rest[1:]
+        try:
+            expansions = expand(rest)
+        except BraceError as exc:
+            raise RuleError(f"{source}:{number}: {exc}") from None
+        for pattern in expansions:
+            rules.append(_make_rule(source, number, line, negated, pattern, base))
+    return rules
