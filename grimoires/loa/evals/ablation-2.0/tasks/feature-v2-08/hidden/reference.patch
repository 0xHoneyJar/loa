diff -ruN a/src/snapkit/glob.py b/src/snapkit/glob.py
--- a/src/snapkit/glob.py
+++ b/src/snapkit/glob.py
@@ -0,0 +1,281 @@
+"""Glob patterns, matched segment by segment.
+
+A pattern is split at every ``/``; each segment is parsed into elements
+(literals, ``?``, ``*``, bracket expressions and extended groups) and matched
+by computing, for every element in turn, the set of positions of the path
+segment it can end at.  ``**`` segments match zero or more whole path
+segments (one or more as the last segment of a pattern with several).
+"""
+import string
+
+from .errors import GlobError
+
+CLASSES = {
+    "alpha": frozenset(string.ascii_letters),
+    "digit": frozenset(string.digits),
+    "alnum": frozenset(string.ascii_letters + string.digits),
+    "upper": frozenset(string.ascii_uppercase),
+    "lower": frozenset(string.ascii_lowercase),
+    "space": frozenset(" \t\n\r\f\v"),
+    "punct": frozenset(string.punctuation),
+}
+GROUP_OPENERS = "?*+@!"
+GLOBSTAR = "**"
+
+
+def _other_case(c):
+    if c.isascii() and c.isalpha():
+        return c.swapcase()
+    return None
+
+
+class _Char:
+    """A one-character element: a literal, ``?`` or a bracket expression."""
+
+    __slots__ = ("test",)
+
+    def __init__(self, test):
+        self.test = test
+
+
+class _Star:
+    __slots__ = ()
+
+
+class _Group:
+    __slots__ = ("op", "alternatives")
+
+    def __init__(self, op, alternatives):
+        self.op = op
+        self.alternatives = alternatives
+
+
+def _scan_bracket(seg, i):
+    """Return (negated, tokens, end) for the bracket at seg[i], or None."""
+    j = i + 1
+    negated = j < len(seg) and seg[j] in "!^"
+    if negated:
+        j += 1
+    tokens = []
+    while j < len(seg):
+        c = seg[j]
+        if c == "]" and tokens:
+            return negated, tokens, j + 1
+        if seg.startswith("[:", j):
+            k = j + 2
+            while k < len(seg) and "a" <= seg[k] <= "z":
+                k += 1
+            if k > j + 2 and seg.startswith(":]", k):
+                tokens.append(("class", seg[j + 2:k]))
+                j = k + 2
+                continue
+        if c == "\\":
+            tokens.append(("char", seg[j + 1], False))
+            j += 2
+        else:
+            tokens.append(("char", c, c == "-"))
+            j += 1
+    return None
+
+
+def _bracket_test(negated, tokens, pattern, casefold):
+    chars, ranges = set(), []
+    k = 0
+    while k < len(tokens):
+        tok = tokens[k]
+        if (tok[0] == "char" and k + 2 < len(tokens) and tokens[k + 1][0] == "char"
+                and tokens[k + 1][2] and tokens[k + 2][0] == "char"):
+            lo, hi = tok[1], tokens[k + 2][1]
+            if lo > hi:
+                raise GlobError(f"invalid range {lo!r}-{hi!r} in pattern {pattern!r}")
+            ranges.append((lo, hi))
+            k += 3
+            continue
+        if tok[0] == "class":
+            if tok[1] not in CLASSES:
+                raise GlobError(f"unknown class {tok[1]!r} in pattern {pattern!r}")
+            chars |= CLASSES[tok[1]]
+        else:
+            chars.add(tok[1])
+        k += 1
+
+    def member(c):
+        return c in chars or any(lo <= c <= hi for lo, hi in ranges)
+
+    def test(c):
+        hit = member(c)
+        if not hit and casefold:
+            other = _other_case(c)
+            hit = other is not None and member(other)
+        return hit != negated
+
+    return test
+
+
+def _literal_test(ch, casefold):
+    if casefold and _other_case(ch) is not None:
+        low = ch.lower()
+        return lambda c: c.isascii() and c.lower() == low
+    return lambda c: c == ch
+
+
+def _any_char(c):
+    return True
+
+
+def _parse(seg, i, pattern, casefold, in_group):
+    """Parse seg[i:]; return (list of alternatives, next index)."""
+    alternatives, elements = [], []
+    while i < len(seg):
+        c = seg[i]
+        if in_group and c == "|":
+            alternatives.append(elements)
+            elements = []
+            i += 1
+        elif in_group and c == ")":
+            alternatives.append(elements)
+            return alternatives, i + 1
+        elif c == "\\":
+            elements.append(_Char(_literal_test(seg[i + 1], casefold)))
+            i += 2
+        elif c in GROUP_OPENERS and seg.startswith("(", i + 1):
+            alts, i = _parse(seg, i + 2, pattern, casefold, True)
+            elements.append(_Group(c, alts))
+        elif c == "*":
+            elements.append(_Star())
+            i += 1
+        elif c == "?":
+            elements.append(_Char(_any_char))
+            i += 1
+        elif c == "[":
+            scanned = _scan_bracket(seg, i)
+            if scanned is None:
+                elements.append(_Char(_literal_test("[", casefold)))
+                i += 1
+            else:
+                negated, tokens, end = scanned
+                elements.append(_Char(_bracket_test(negated, tokens, pattern, casefold)))
+                i = end
+        else:
+            elements.append(_Char(_literal_test(c, casefold)))
+            i += 1
+    if in_group:
+        raise GlobError(f"unclosed group in pattern {pattern!r}")
+    alternatives.append(elements)
+    return alternatives, i
+
+
+class _SegmentMatcher:
+    """Match one path segment against parsed elements via end-position sets."""
+
+    def __init__(self, text):
+        self.text = text
+        self.memo = {}
+
+    def seq_ends(self, elements, start):
+        key = (id(elements), start)
+        hit = self.memo.get(key)
+        if hit is not None:
+            return hit
+        positions = {start}
+        for element in elements:
+            nxt = set()
+            for p in positions:
+                nxt |= self.element_ends(element, p)
+            positions = nxt
+            if not positions:
+                break
+        result = frozenset(positions)
+        self.memo[key] = result
+        return result
+
+    def union_ends(self, alternatives, start):
+        ends = set()
+        for alt in alternatives:
+            ends |= self.seq_ends(alt, start)
+        return ends
+
+    def plus_ends(self, alternatives, start):
+        reached = set(self.union_ends(alternatives, start))
+        frontier = [p for p in reached if p > start]
+        while frontier:
+            p = frontier.pop()
+            for q in self.union_ends(alternatives, p):
+                if q not in reached:
+                    reached.add(q)
+                    frontier.append(q)
+        return reached
+
+    def element_ends(self, element, start):
+        n = len(self.text)
+        if isinstance(element, _Char):
+            if start < n and element.test(self.text[start]):
+                return {start + 1}
+            return set()
+        if isinstance(element, _Star):
+            return set(range(start, n + 1))
+        op, alts = element.op, element.alternatives
+        if op == "@":
+            return self.union_ends(alts, start)
+        if op == "?":
+            return {start} | self.union_ends(alts, start)
+        if op == "+":
+            return self.plus_ends(alts, start)
+        if op == "*":
+            return {start} | self.plus_ends(alts, start)
+        inside = self.union_ends(alts, start)
+        return {p for p in range(start, n + 1) if p not in inside}
+
+
+def _trailing_backslash(seg):
+    stripped = seg.rstrip("\\")
+    return (len(seg) - len(stripped)) % 2 == 1
+
+
+class Glob:
+    """A validated glob pattern; ``match(path)`` tests a relative path."""
+
+    def __init__(self, pattern, casefold=False):
+        self.pattern = pattern
+        self.casefold = casefold
+        segments = pattern.split("/")
+        for seg in segments:
+            if _trailing_backslash(seg):
+                raise GlobError(f"trailing backslash in pattern {pattern!r}")
+        self._segments = []
+        for seg in segments:
+            if seg == GLOBSTAR:
+                self._segments.append(GLOBSTAR)
+            else:
+                self._segments.append(_parse(seg, 0, pattern, casefold, False)[0][0])
+
+    @staticmethod
+    def _segment_matches(elements, text):
+        return len(text) in _SegmentMatcher(text).seq_ends(elements, 0)
+
+    def match(self, path):
+        parts = path.split("/")
+        segs = self._segments
+        last = len(segs) - 1
+        states = {0}
+        for k, seg in enumerate(segs):
+            nxt = set()
+            if seg is GLOBSTAR:
+                least = 1 if (k == last and len(segs) > 1) else 0
+                for s in states:
+                    nxt.update(range(s + least, len(parts) + 1))
+            else:
+                for s in states:
+                    if s < len(parts) and self._segment_matches(seg, parts[s]):
+                        nxt.add(s + 1)
+            states = nxt
+            if not states:
+                return False
+        return len(parts) in states
+
+    def __repr__(self):
+        return f"Glob({self.pattern!r}, casefold={self.casefold!r})"
+
+
+def match(pattern, path, casefold=False):
+    return Glob(pattern, casefold).match(path)
diff -ruN a/src/snapkit/ignore.py b/src/snapkit/ignore.py
--- a/src/snapkit/ignore.py
+++ b/src/snapkit/ignore.py
@@ -0,0 +1,57 @@
+"""Evaluation of ignore rules: config entries first, then rules files by depth.
+
+``check(path, is_dir)`` judges every proper ancestor directory, shallowest
+first, then the path; the first excluded one decides, so nothing inside an
+excluded directory is ever included again.
+"""
+from .paths import ancestors, depth
+from .rules import Rule
+
+
+class Decision:
+    __slots__ = ("excluded", "rule")
+
+    def __init__(self, excluded, rule):
+        self.excluded = excluded
+        self.rule = rule
+
+    def __repr__(self):
+        return f"Decision(excluded={self.excluded!r}, rule={self.rule!r})"
+
+
+class IgnoreRules:
+    def __init__(self, casefold=False, fixed=()):
+        self.casefold = casefold
+        self.fixed = {}
+        for n, entry in enumerate(fixed, 1):
+            self.fixed.setdefault(entry, Rule("config", n, entry, False, False, False, entry, ""))
+        self._files = {}
+
+    def add_file(self, base, rules):
+        self._files[base] = list(rules)
+
+    def _ordered(self):
+        for base in sorted(self._files, key=depth):
+            yield from self._files[base]
+
+    def judge(self, path, is_dir):
+        """(excluded, rule) for ``path`` alone, ancestors not considered."""
+        fixed = self.fixed.get(path)
+        if fixed is not None:
+            return True, fixed
+        last = None
+        for rule in self._ordered():
+            if rule.matches(path, is_dir, self.casefold):
+                last = rule
+        return (last is not None and not last.negated), last
+
+    def check(self, path, is_dir):
+        for anc in ancestors(path):
+            excluded, rule = self.judge(anc, True)
+            if excluded:
+                return Decision(True, rule)
+        excluded, rule = self.judge(path, is_dir)
+        return Decision(excluded, rule)
+
+    def excluded(self, path, is_dir):
+        return self.check(path, is_dir).excluded
