+"""Brace expansion for rules-file lines and the ``match`` command.
+
+Lists ``{a,b}`` and sequences ``{1..5}``, ``{a..e}``, ``{01..10..3}`` expand
+to every combination, leftmost braces varying slowest; braces that form
+neither stay literal.  Backslashes are kept for the glob to read.
+"""
+import re
+from itertools import product
+
+from .errors import BraceError
+
+LIMIT = 256
+_INT = r"-?[0-9]+"
+_INT_SEQ = re.compile(rf"({_INT})\.\.({_INT})(?:\.\.({_INT}))?\Z")
+_CHAR_SEQ = re.compile(rf"([a-z]\.\.[a-z]|[A-Z]\.\.[A-Z])(?:\.\.({_INT}))?\Z")
+
+
+def _closing(text, start):
+    depth = 0
+    i = start
+    while i < len(text):
+        c = text[i]
+        if c == "\\":
+            i += 2
+            continue
+        if c == "{":
+            depth += 1
+        elif c == "}":
+            depth -= 1
+            if depth == 0:
+                return i
+        i += 1
+    return -1
+
+
+def _split_items(body):
+    items, depth, last, i = [], 0, 0, 0
+    while i < len(body):
+        c = body[i]
+        if c == "\\":
+            i += 2
+            continue
+        if c == "{":
+            depth += 1
+        elif c == "}":
+            depth -= 1
+        elif c == "," and depth == 0:
+            items.append(body[last:i])
+            last = i + 1
+        i += 1
+    items.append(body[last:])
+    return items
+
+
+def _format_numbers(x, y, values):
+    pad = any(len(t.lstrip("-")) > 1 and t.lstrip("-").startswith("0") for t in (x, y))
+    if not pad:
+        return [str(v) for v in values]
+    width = max(len(x), len(y))
+    return [("-" + str(-v).zfill(width - 1)) if v < 0 else str(v).zfill(width) for v in values]
+
+
+def _sequence(body):
+    m = _INT_SEQ.match(body)
+    if m:
+        x, y, s = m.group(1), m.group(2), m.group(3)
+        step = abs(int(s)) if s is not None else 1
+        if step == 0:
+            return None
+        a, b = int(x), int(y)
+        values = range(a, b + 1, step) if a <= b else range(a, b - 1, -step)
+        return _format_numbers(x, y, list(values))
+    m = _CHAR_SEQ.match(body)
+    if m:
+        a, b = ord(m.group(1)[0]), ord(m.group(1)[-1])
+        step = abs(int(m.group(2))) if m.group(2) is not None else 1
+        if step == 0:
+            return None
+        values = range(a, b + 1, step) if a <= b else range(a, b - 1, -step)
+        return [chr(v) for v in values]
+    return None
+
+
+def _parts(text):
+    """Split text into a list of alternatives-lists (literal text is a 1-list)."""
+    parts, literal, i = [], [], 0
+    while i < len(text):
+        c = text[i]
+        if c == "\\":
+            literal.append(text[i:i + 2])
+            i += 2
+            continue
+        if c == "{":
+            end = _closing(text, i)
+            if end >= 0:
+                body = text[i + 1:end]
+                items = _split_items(body)
+                if len(items) > 1:
+                    choices = [s for item in items for s in _expand_all(item)]
+                else:
+                    choices = _sequence(body)
+                if choices is not None:
+                    parts.append(["".join(literal)])
+                    parts.append(choices)
+                    literal = []
+                    i = end + 1
+                    continue
+        literal.append(c)
+        i += 1
+    parts.append(["".join(literal)])
+    return parts
+
+
+def _expand_all(text):
+    return ["".join(combo) for combo in product(*_parts(text))]
+
+
+def expand(text):
+    """Every string the brace expansion of ``text`` makes, duplicates removed."""
+    raw = _expand_all(text)
+    if len(raw) > LIMIT:
+        raise BraceError(f"brace expansion exceeds {LIMIT} patterns")
+    return list(dict.fromkeys(raw))
