+"""Plain data: versions, comparators and the enums that name their parts."""
+
+import enum
+from dataclasses import dataclass
+
+__all__ = ["Comparator", "Op", "Part", "Partial", "Prefix", "Version"]
+
+
+class Op(enum.Enum):
+    """A comparator operator."""
+
+    LT = "<"
+    LE = "<="
+    GT = ">"
+    GE = ">="
+    EQ = "="
+
+
+class Prefix(enum.Enum):
+    """The operator written before a partial version in a range."""
+
+    NONE = ""
+    EQ = "="
+    LT = "<"
+    LE = "<="
+    GT = ">"
+    GE = ">="
+    CARET = "^"
+    TILDE = "~"
+
+
+class Part(enum.Enum):
+    """A part of a version that a bump changes."""
+
+    MAJOR = "major"
+    MINOR = "minor"
+    PATCH = "patch"
+    PRERELEASE = "prerelease"
+    RELEASE = "release"
+
+
+@dataclass(frozen=True, slots=True)
+class Version:
+    """A parsed semantic version."""
+
+    major: int
+    minor: int
+    patch: int
+    prerelease: tuple[int | str, ...] = ()
+    build: tuple[str, ...] = ()
+
+
+@dataclass(frozen=True, slots=True)
+class Comparator:
+    """One operator applied to one version."""
+
+    op: Op
+    version: Version
+
+
+@dataclass(frozen=True, slots=True)
+class Partial:
+    """A version in a range whose missing or wildcard parts are None."""
+
+    major: int | None
+    minor: int | None
+    patch: int | None
+    prerelease: tuple[int | str, ...] = ()
