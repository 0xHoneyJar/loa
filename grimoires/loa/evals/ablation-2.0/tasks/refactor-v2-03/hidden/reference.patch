diff -ruN a/src/ticketdesk/context.py b/src/ticketdesk/context.py
--- a/src/ticketdesk/context.py
+++ b/src/ticketdesk/context.py
@@ -0,0 +1,23 @@
+"""Everything one desk knows: its settings, tickets, audit log and clock."""
+from .config import DEFAULT_SLA_HOURS, PRIORITIES
+
+
+class Context:
+    """The explicit state every desk function takes as ``ctx``; settings are checked here."""
+
+    def __init__(self, *, sla_hours=None, max_open_per_agent=3, clock=None):
+        hours = dict(DEFAULT_SLA_HOURS)
+        for priority, value in (sla_hours or {}).items():
+            if priority not in PRIORITIES:
+                raise ValueError(f"unknown priority: {priority!r}")
+            if isinstance(value, bool) or not isinstance(value, int) or value < 1:
+                raise ValueError(f"bad SLA for {priority}: {value!r}")
+            hours[priority] = value
+        if isinstance(max_open_per_agent, bool) or not isinstance(max_open_per_agent, int) or max_open_per_agent < 1:
+            raise ValueError(f"bad max_open_per_agent: {max_open_per_agent!r}")
+        self.sla_hours = hours
+        self.max_open_per_agent = max_open_per_agent
+        self.clock = clock
+        self.tickets = {}
+        self.next_id = 1
+        self.events = []
