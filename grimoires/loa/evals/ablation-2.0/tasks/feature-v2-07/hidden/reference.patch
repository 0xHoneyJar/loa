+"""Cron schedules: five-field expressions evaluated on local wall-clock time.
+
+``parse_cron(text, horizon_days)`` parses an expression into a CronSchedule;
+``CronSchedule.next_after(instant, zone)`` finds the first fire instant
+strictly after ``instant``.  A minute fires when its local wall time matches
+and that wall time has not already occurred at an earlier instant (so a
+wall time repeated by a backward offset change fires once, and a wall time
+skipped by a forward change never fires).
+"""
+import calendar
+import datetime
+import re
+
+from .errors import CronError
+from .schedule import DEFAULT_HORIZON_DAYS
+from .timeutil import to_datetime
+
+FIELDS = (("minute", 0, 59), ("hour", 0, 23), ("dom", 1, 31), ("month", 1, 12), ("dow", 0, 7))
+MONTH_NAMES = {name: index for index, name in enumerate(
+    ("JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"), 1)}
+DAY_NAMES = {name: index for index, name in enumerate(("SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"))}
+MACROS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+}
+_DIGITS = re.compile(r"^[0-9]+$")
+_DOM_W = re.compile(r"^([0-9]+)W$", re.IGNORECASE)
+_DOW_LAST = re.compile(r"^([0-9]+|[A-Za-z]{3})L$", re.IGNORECASE)
+_DOW_NTH = re.compile(r"^([0-9]+|[A-Za-z]{3})#([0-9]+)$")
+_EPOCH_DATE = datetime.date(1970, 1, 1)
+SPAN_DAYS = 1096
+
+
+class _Bad(Exception):
+    """A field-level reason; parse_cron prefixes the field."""
+
+
+class _Field:
+    def __init__(self, text):
+        self.text = text
+        self.values = set()
+        self.last = False          # dom L
+        self.last_weekday = False  # dom LW
+        self.nearest = set()       # dom nW
+        self.last_of = set()       # dow nL
+        self.nth = set()           # dow (n, k)
+
+    @property
+    def restricted(self):
+        return self.text != "*"
+
+
+def _value(text, index):
+    name, low, high = FIELDS[index]
+    if _DIGITS.match(text):
+        value = int(text)
+    else:
+        names = MONTH_NAMES if name == "month" else DAY_NAMES if name == "dow" else {}
+        if text.upper() not in names:
+            raise _Bad(f"bad value {text!r}")
+        value = names[text.upper()]
+    if not low <= value <= high:
+        raise _Bad(f"value {value} out of range {low}-{high}")
+    return value
+
+
+def _special(item, index, field):
+    """Handle L / LW / nW (dom) and nL / n#k (dow); False when the item is not special."""
+    name = FIELDS[index][0]
+    if name == "dom":
+        if item.upper() == "L":
+            field.last = True
+            return True
+        if item.upper() == "LW":
+            field.last_weekday = True
+            return True
+        match = _DOM_W.match(item)
+        if match:
+            field.nearest.add(_value(match.group(1), index))
+            return True
+    elif name == "dow":
+        match = _DOW_LAST.match(item)
+        if match:
+            field.last_of.add(_value(match.group(1), index) % 7)
+            return True
+        match = _DOW_NTH.match(item)
+        if match:
+            day = _value(match.group(1), index) % 7
+            occurrence = int(match.group(2))
+            if not 1 <= occurrence <= 5:
+                raise _Bad(f"occurrence {occurrence} out of range 1-5")
+            field.nth.add((day, occurrence))
+            return True
+    return False
+
+
+def _item(item, index, field):
+    _, low, high = FIELDS[index]
+    if item == "":
+        raise _Bad("empty item")
+    if _special(item, index, field):
+        return
+    base, slash, step_text = item.partition("/")
+    if base == "*":
+        start, end = low, high
+    elif "-" in base:
+        first, _, second = base.partition("-")
+        start, end = _value(first, index), _value(second, index)
+        if start > end:
+            raise _Bad(f"reversed range {base!r}")
+    else:
+        start = _value(base, index)
+        end = high if slash else start
+    step = 1
+    if slash:
+        if not _DIGITS.match(step_text):
+            raise _Bad(f"bad step {step_text!r}")
+        step = int(step_text)
+        if step < 1:
+            raise _Bad("step must be at least 1")
+    values = range(start, end + 1, step)
+    if FIELDS[index][0] == "dow":
+        values = [value % 7 for value in values]
+    field.values.update(values)
+
+
+def _field(text, index):
+    field = _Field(text)
+    for item in text.split(","):
+        _item(item, index, field)
+    return field
+
+
+def _last_day(year, month):
+    return calendar.monthrange(year, month)[1]
+
+
+def _cron_weekday(day):
+    return (day.weekday() + 1) % 7
+
+
+def _nearest_weekday(year, month, nominal):
+    last = _last_day(year, month)
+    if nominal > last:
+        return None
+    weekday = _cron_weekday(datetime.date(year, month, nominal))
+    if weekday == 6:
+        return nominal - 1 if nominal > 1 else nominal + 2
+    if weekday == 0:
+        return nominal + 1 if nominal < last else nominal - 2
+    return nominal
+
+
+def _pieces(zone, low, high, reverse):
+    """Split minute indexes ``[low, high]`` into constant-offset pieces.
+
+    Yields ``(begin, end, offset, prior)``: minute indexes ``begin..end`` share
+    ``offset``, and ``prior`` is the largest wall minute reached by any minute
+    index before the piece's offset span began (a wall above it cannot have
+    occurred earlier)."""
+    if low > high:
+        return
+    bounds = []  # (first minute index of a span, offset)
+    for when, _ in zone.changes:
+        index = -(-when // 60)
+        if not bounds or bounds[-1][0] != index:
+            bounds.append((index, zone.offset_at(index * 60)))
+        else:
+            bounds[-1] = (index, zone.offset_at(index * 60))
+    spans = []
+    begin, offset, prior = None, zone.offset_at((bounds[0][0] - 1) * 60) if bounds else zone.initial, None
+    for index, value in bounds:
+        spans.append((begin, index - 1, offset, prior))
+        top = index - 1 + offset
+        prior = top if prior is None else max(prior, top)
+        begin, offset = index, value
+    spans.append((begin, None, offset, prior))
+    pieces = []
+    for begin, end, offset, prior in spans:
+        lo = low if begin is None else max(low, begin)
+        hi = high if end is None else min(high, end)
+        if lo <= hi:
+            pieces.append((lo, hi, offset, float("-inf") if prior is None else prior))
+    yield from (reversed(pieces) if reverse else pieces)
+
+
+class CronSchedule:
+    def __init__(self, text, fields, horizon_days):
+        self.text = text
+        self.minute, self.hour, self.dom, self.month, self.dow = fields
+        self.horizon_days = horizon_days
+
+    def describe(self):
+        return "cron " + self.text
+
+    def _dom_matches(self, day):
+        field = self.dom
+        if day.day in field.values:
+            return True
+        last = _last_day(day.year, day.month)
+        if field.last and day.day == last:
+            return True
+        if field.last_weekday:
+            final = datetime.date(day.year, day.month, last)
+            shift = {6: 1, 0: 2}.get(_cron_weekday(final), 0)
+            if day.day == last - shift:
+                return True
+        return any(_nearest_weekday(day.year, day.month, n) == day.day for n in field.nearest)
+
+    def _dow_matches(self, day):
+        field = self.dow
+        weekday = _cron_weekday(day)
+        if weekday in field.values:
+            return True
+        if weekday in field.last_of and day.day + 7 > _last_day(day.year, day.month):
+            return True
+        return (weekday, (day.day - 1) // 7 + 1) in field.nth
+
+    def day_matches(self, day):
+        if day.month not in self.month.values:
+            return False
+        if self.dom.restricted and self.dow.restricted:
+            return self._dom_matches(day) or self._dow_matches(day)
+        if self.dom.restricted:
+            return self._dom_matches(day)
+        if self.dow.restricted:
+            return self._dow_matches(day)
+        return True
+
+    def matches(self, wall):
+        """Whether the wall minute ``wall`` (a naive datetime) matches the expression."""
+        return wall.minute in self.minute.values and wall.hour in self.hour.values and self.day_matches(wall.date())
+
+    def _first_occurrence(self, wall_minutes, zone):
+        """The earliest instant whose wall time is ``wall_minutes`` (minutes since the epoch), or None."""
+        best = None
+        for offset in zone.offsets():
+            instant = (wall_minutes - offset) * 60
+            if zone.offset_at(instant) == offset and (best is None or instant < best):
+                best = instant
+        return best
+
+    def _walls(self, first, last, reverse=False):
+        """Matching wall minutes (minutes since the epoch) in ``[first, last]``, ascending or descending."""
+        if first > last:
+            return
+        day = to_datetime(first * 60).date()
+        final = to_datetime(last * 60).date()
+        hours = sorted(self.hour.values, reverse=reverse)
+        minutes = sorted(self.minute.values, reverse=reverse)
+        step = datetime.timedelta(days=-1 if reverse else 1)
+        if reverse:
+            day, final = final, day
+        while (day >= final) if reverse else (day <= final):
+            if self.day_matches(day):
+                base = (day - _EPOCH_DATE).days * 1440
+                for hour in hours:
+                    for minute in minutes:
+                        wall = base + hour * 60 + minute
+                        if first <= wall <= last:
+                            yield wall
+            day += step
+
+    def _fires(self, zone, low, high, reverse=False):
+        """Fire instants with minute index in ``[low, high]``, in time order (or reversed)."""
+        for begin, end, offset, prior in _pieces(zone, low, high, reverse):
+            for wall in self._walls(begin + offset, end + offset, reverse):
+                instant = (wall - offset) * 60
+                if wall > prior or self._first_occurrence(wall, zone) == instant:
+                    yield instant
+
+    def next_after(self, instant, zone):
+        """The first fire instant strictly after ``instant``; CronError past the horizon."""
+        for fire in self._fires(zone, instant // 60 + 1, (instant + self.horizon_days * 86400) // 60):
+            return fire
+        raise CronError(f"no fire time within {self.horizon_days} days")
+
+    def prev_before(self, instant, zone):
+        """The last fire instant strictly before ``instant``; CronError past the horizon."""
+        low = -(-(instant - self.horizon_days * 86400) // 60)
+        for fire in self._fires(zone, low, -(-instant // 60) - 1, reverse=True):
+            return fire
+        raise CronError(f"no fire time within {self.horizon_days} days before")
+
+    def count_between(self, start, end, zone):
+        """How many fire instants lie in ``(start, end]``."""
+        if end < start:
+            raise CronError("end before start")
+        if end - start > SPAN_DAYS * 86400:
+            raise CronError(f"span longer than {SPAN_DAYS} days")
+        return sum(1 for _ in self._fires(zone, start // 60 + 1, end // 60))
+
+    def nth_after(self, instant, n, zone):
+        """The n-th fire instant after ``instant`` (n >= 1) within SPAN_DAYS days."""
+        if n < 1:
+            raise CronError("n must be at least 1")
+        seen = 0
+        for fire in self._fires(zone, instant // 60 + 1, (instant + SPAN_DAYS * 86400) // 60):
+            seen += 1
+            if seen == n:
+                return fire
+        raise CronError(f"fewer than {n} fire times within {SPAN_DAYS} days")
+
+    def __repr__(self):
+        return f"CronSchedule({self.text!r})"
+
+
+def parse_cron(text, horizon_days=DEFAULT_HORIZON_DAYS):
+    """Parse a cron expression or macro; raises CronError."""
+    stripped = text.strip()
+    if not stripped:
+        raise CronError("empty expression")
+    if stripped.startswith("@"):
+        expanded = MACROS.get(stripped.lower())
+        if expanded is None:
+            raise CronError(f"unknown macro {stripped!r}")
+        shown, words = stripped, expanded.split()
+    else:
+        words = stripped.split()
+        if len(words) != 5:
+            raise CronError(f"expected 5 fields, got {len(words)}")
+        shown = " ".join(words)
+    fields = []
+    for index, word in enumerate(words):
+        try:
+            fields.append(_field(word, index))
+        except _Bad as exc:
+            raise CronError(f"field {index + 1} ({FIELDS[index][0]}): {exc}") from None
+    return CronSchedule(shown, fields, horizon_days)
