+class InterpolationError(ConfigError):
+    pass
+
+
+def interpolate(value, env, line):
+    out, i = [], 0
+    while i < len(value):
+        c = value[i]
+        if c == "$" and value[i + 1:i + 2] == "$":
+            out.append("$")
+            i += 2
+        elif c == "$" and value[i + 1:i + 2] == "{":
+            end = value.find("}", i + 2)
+            if end < 0:
+                raise InterpolationError("unterminated variable reference", line)
+            name, sep, default = value[i + 2:end].partition(":-")
+            if not VAR_RX.fullmatch(name):
+                raise InterpolationError(f"invalid variable name: {name}", line)
+            got = env.get(name)
+            if sep and not got:
+                got = default
+            elif got is None:
+                raise InterpolationError(f"undefined variable: {name}", line)
+            out.append(got)
+            i = end + 1
+        else:
+            out.append(c)
+            i += 1
+    return "".join(out)
+
