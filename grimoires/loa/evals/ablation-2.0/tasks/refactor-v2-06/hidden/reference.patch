+"""Plain data: fields, special day items, schedules and their enums."""
+
+import enum
+from dataclasses import dataclass
+
+__all__ = ["Field", "FieldKind", "Schedule", "Special", "SpecialDay"]
+
+
+class FieldKind(enum.Enum):
+    """One of the five fields of an expression."""
+
+    MINUTE = "minute"
+    HOUR = "hour"
+    DAY = "day-of-month"
+    MONTH = "month"
+    WEEKDAY = "day-of-week"
+
+
+class Special(enum.Enum):
+    """A day item that is not a plain number."""
+
+    MONTH_END = "L"
+    MONTH_END_WEEKDAY = "LW"
+    MONTH_END_OFFSET = "L-"
+    NEAREST_WEEKDAY = "W"
+    LAST_WEEKDAY = "dL"
+    NTH_WEEKDAY = "#"
+
+
+@dataclass(frozen=True, slots=True)
+class SpecialDay:
+    """A special item with its number and, for NTH_WEEKDAY, its ordinal."""
+
+    kind: Special
+    number: int
+    nth: int = 0
+
+
+@dataclass(frozen=True, slots=True)
+class Field:
+    """One parsed field."""
+
+    kind: FieldKind
+    values: frozenset[int]
+    specials: tuple[SpecialDay, ...] = ()
+    starred: bool = False
+
+
+@dataclass(frozen=True, slots=True)
+class Schedule:
+    """A parsed five-field expression."""
+
+    minute: Field
+    hour: Field
+    day: Field
+    month: Field
+    weekday: Field
