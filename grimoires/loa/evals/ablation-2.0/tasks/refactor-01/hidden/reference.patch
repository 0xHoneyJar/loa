diff -ruN a/src/ledgerio/validation.py b/src/ledgerio/validation.py
--- a/src/ledgerio/validation.py
+++ b/src/ledgerio/validation.py
@@ -0,0 +1,28 @@
+"""The record rules every ledger reader applies."""
+import datetime
+import re
+
+from .errors import RecordError
+
+FIELDS = ("id", "amount", "currency", "date")
+_CURRENCY = re.compile(r"[A-Z]{3}")
+
+
+def validate_record(record) -> None:
+    """Raise ``RecordError`` when ``record`` breaks a rule; return None otherwise."""
+    if not isinstance(record, dict):
+        raise RecordError("record must be a mapping")
+    for field in FIELDS:
+        if field not in record:
+            raise RecordError(f"missing field: {field}")
+    if not isinstance(record["id"], str) or not record["id"].strip():
+        raise RecordError("id must be a non-empty string")
+    amount = record["amount"]
+    if isinstance(amount, bool) or not isinstance(amount, (int, float)) or amount < 0:
+        raise RecordError("amount must be a non-negative number")
+    if not isinstance(record["currency"], str) or not _CURRENCY.fullmatch(record["currency"]):
+        raise RecordError("currency must be a three-letter ISO code")
+    try:
+        datetime.date.fromisoformat(record["date"])
+    except (TypeError, ValueError):
+        raise RecordError("date must be an ISO date (YYYY-MM-DD)") from None
