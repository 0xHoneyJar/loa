diff -ruN a/src/orderdesk/validation.py b/src/orderdesk/validation.py
--- a/src/orderdesk/validation.py
+++ b/src/orderdesk/validation.py
@@ -0,0 +1,17 @@
+"""The one check of an order line (SKU format and quantity) that every operation uses."""
+import re
+
+MAX_QTY = 999
+MAX_BULK_QTY = 9999
+_SKU_RE = re.compile(r"[A-Z]{3}-[0-9]{4}")
+
+
+def validate_line(sku, qty, *, normalise=False, max_qty=MAX_QTY):
+    """Return ``(sku, qty)`` for a valid line; ``normalise`` strips and upper-cases the SKU first."""
+    if normalise and isinstance(sku, str):
+        sku = sku.strip().upper()
+    if not isinstance(sku, str) or _SKU_RE.fullmatch(sku) is None:
+        raise ValueError(f"invalid sku: {sku!r}")
+    if isinstance(qty, bool) or not isinstance(qty, int) or not 1 <= qty <= max_qty:
+        raise ValueError(f"invalid quantity for {sku}: {qty!r}")
+    return sku, qty
