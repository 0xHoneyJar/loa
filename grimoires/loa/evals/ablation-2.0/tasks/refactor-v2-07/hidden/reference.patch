+"""Plain data: operations, targets and the operation kinds."""
+
+import enum
+from dataclasses import dataclass
+
+__all__ = ["JsonType", "OpKind", "Operation", "Target"]
+
+
+class OpKind(enum.Enum):
+    """The six operations of RFC 6902."""
+
+    ADD = "add"
+    REMOVE = "remove"
+    REPLACE = "replace"
+    MOVE = "move"
+    COPY = "copy"
+    TEST = "test"
+
+
+class JsonType(enum.Enum):
+    """The six JSON value types, in report order."""
+
+    OBJECT = "object"
+    ARRAY = "array"
+    STRING = "string"
+    NUMBER = "number"
+    BOOLEAN = "boolean"
+    NULL = "null"
+
+
+@dataclass(frozen=True, slots=True)
+class Operation:
+    """One validated operation; source is the from pointer of move and copy."""
+
+    kind: OpKind
+    path: str
+    value: object = None
+    source: str = ""
+    index: int = 0
+
+
+@dataclass(frozen=True, slots=True)
+class Target:
+    """A parsed pointer with its text and the operation it belongs to."""
+
+    tokens: tuple[str, ...]
+    pointer: str
+    index: int = -1
