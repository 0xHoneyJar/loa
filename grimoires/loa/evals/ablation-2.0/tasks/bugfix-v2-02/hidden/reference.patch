@@ -2,6 +2,7 @@
 from .model import ParseError
 
 ESCAPES = {"\\": "\\\\", '"': '\\"', "\n": "\\n", "\t": "\\t", "\r": "\\r"}
+DECODE = {"\\": "\\", '"': '"', "n": "\n", "t": "\t", "r": "\r"}
 
 
 def quote(value):
@@ -27,6 +28,22 @@
 
 
 def unquote(body, line):
-    """Decode the escapes of a quoted body."""
-    return (body.replace("\\n", "\n").replace("\\t", "\t").replace("\\r", "\r")
-            .replace('\\"', '"').replace("\\\\", "\\"))
+    """Decode the escapes of a quoted body in one left-to-right pass.
+
+    Chained ``str.replace`` calls cannot do this: whichever escape is
+    decoded first also matches inside another (``\\\\n`` is a backslash
+    and an ``n``, not a backslash and a newline).
+    """
+    out, i = [], 0
+    while i < len(body):
+        ch = body[i]
+        if ch != "\\":
+            out.append(ch)
+            i += 1
+            continue
+        nxt = body[i + 1] if i + 1 < len(body) else ""
+        if nxt not in DECODE:
+            raise ParseError(line, f"bad escape: \\{nxt}")
+        out.append(DECODE[nxt])
+        i += 2
+    return "".join(out)
