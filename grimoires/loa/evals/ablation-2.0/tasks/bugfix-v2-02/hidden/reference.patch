diff -ruN a/src/kvconf/writer.py b/src/kvconf/writer.py
--- a/src/kvconf/writer.py
+++ b/src/kvconf/writer.py
@@ -3,8 +3,15 @@
 
 
 def needs_quotes(value):
-    """Whether ``value`` cannot be written bare."""
-    return (value == "" or value[0].isspace() or value[0] == '"'
+    """Whether ``value`` cannot be written bare.
+
+    The reader strips surrounding whitespace from a bare value, ends it at an
+    inline comment and treats a leading quote as the start of a quoted value,
+    so each of those has to be quoted, as do the characters only an escape
+    can carry.
+    """
+    return (value == "" or value[0].isspace() or value[-1].isspace()
+            or value[0] == '"' or "#" in value or ";" in value
             or any(ch in value for ch in '\\"\n\t\r'))
 
 
diff -ruN a/tests/test_regressions.py b/tests/test_regressions.py
--- a/tests/test_regressions.py
+++ b/tests/test_regressions.py
@@ -0,0 +1,28 @@
+import pytest
+
+from kvconf import Config, ParseError, dumps, loads, merge
+
+
+def test_awkward_values_round_trip():
+    config = Config()
+    for i, value in enumerate(["x ", "a # b", "a ;b", "C:\\new\\temp", "a\\\\n\nb", ""]):
+        config.set("s", f"k{i}", value)
+    assert loads(dumps(config)) == config
+
+
+def test_unknown_escape_is_refused():
+    with pytest.raises(ParseError, match=r"^line 2: bad escape: \\q$"):
+        loads('[s]\nk = "\\q"\n')
+
+
+def test_names_keep_spelling_and_match_any_case():
+    config = loads("[User]\nDisplayName = Al\n")
+    assert config.keys("user") == ["DisplayName"]
+    config.set("USER", "displayname", "Bo")
+    assert config.items("User") == [("DisplayName", "Bo")]
+
+
+def test_merge_does_not_duplicate_names():
+    merged = merge(loads("[User]\nName = a\n"), loads("[user]\nname = b\n"))
+    assert merged.items("User") == [("Name", "b")]
+    assert loads(dumps(merged)) == merged
