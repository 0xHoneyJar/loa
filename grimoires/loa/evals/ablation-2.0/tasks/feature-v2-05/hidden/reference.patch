--- a/src/docstore/patch.py
+++ b/src/docstore/patch.py
@@ -0,0 +1,154 @@
+"""JSON Patch (RFC 6902 as specified for docstore).
+
+``apply_patch(doc, ops, max_ops)`` checks every operation's syntax first, then
+applies the operations in order to a deep copy of ``doc``. ``json_equal`` is the
+equality the ``test`` operation uses.
+"""
+import copy
+from collections import namedtuple
+
+from .errors import PatchError, PointerError
+from .pointer import array_index, parse_pointer, walk
+
+PatchResult = namedtuple("PatchResult", "revision document")
+
+OPS = ("add", "remove", "replace", "move", "copy", "test")
+_NEEDS_FROM = ("move", "copy")
+_NEEDS_VALUE = ("add", "replace", "test")
+
+
+def json_equal(a, b):
+    """JSON equality: numbers by value, booleans apart from numbers, objects unordered."""
+    if isinstance(a, bool) or isinstance(b, bool):
+        return isinstance(a, bool) and isinstance(b, bool) and a == b
+    if isinstance(a, (int, float)) and isinstance(b, (int, float)):
+        return a == b
+    if a is None or b is None:
+        return a is None and b is None
+    if isinstance(a, str) and isinstance(b, str):
+        return a == b
+    if isinstance(a, list) and isinstance(b, list):
+        return len(a) == len(b) and all(json_equal(x, y) for x, y in zip(a, b))
+    if isinstance(a, dict) and isinstance(b, dict):
+        return a.keys() == b.keys() and all(json_equal(a[k], b[k]) for k in a)
+    return False
+
+
+class _Op:
+    def __init__(self, index, name, path, tokens, source=None, from_tokens=None, value=None):
+        self.index, self.name = index, name
+        self.path, self.tokens = path, tokens
+        self.source, self.from_tokens = source, from_tokens
+        self.value = value
+
+    def fail(self, reason):
+        return PatchError(f"op {self.index} ({self.name}): {reason}")
+
+
+def _pointer_member(op, index, name, member):
+    if member not in op:
+        raise PatchError(f"op {index} ({name}): missing {member!r}")
+    text = op[member]
+    if not isinstance(text, str):
+        raise PatchError(f"op {index} ({name}): {member!r} must be a string")
+    try:
+        return text, parse_pointer(text)
+    except PointerError as exc:
+        raise PatchError(f"op {index} ({name}): {exc}") from None
+
+
+def _check(index, op):
+    if not isinstance(op, dict):
+        raise PatchError(f"op {index}: operation must be an object")
+    if "op" not in op:
+        raise PatchError(f"op {index}: missing 'op'")
+    name = op["op"]
+    if not isinstance(name, str) or name not in OPS:
+        raise PatchError(f"op {index}: unknown op {name!r}")
+    path, tokens = _pointer_member(op, index, name, "path")
+    parsed = _Op(index, name, path, tokens)
+    if name in _NEEDS_FROM:
+        parsed.source, parsed.from_tokens = _pointer_member(op, index, name, "from")
+    if name in _NEEDS_VALUE:
+        if "value" not in op:
+            raise PatchError(f"op {index} ({name}): missing 'value'")
+        parsed.value = op["value"]
+    return parsed
+
+
+def _parent(doc, tokens, pointer):
+    return walk(doc, tokens[:-1], pointer)
+
+
+def _add(doc, tokens, pointer, value):
+    """Add ``value`` at ``tokens``; returns the new document."""
+    if not tokens:
+        return value
+    parent, last = _parent(doc, tokens, pointer), tokens[-1]
+    if isinstance(parent, dict):
+        parent[last] = value
+    elif isinstance(parent, list):
+        parent.insert(array_index(last, pointer, len(parent), True), value)
+    else:
+        raise PointerError(f"path {pointer!r} does not exist")
+    return doc
+
+
+def _remove(doc, tokens, pointer):
+    """Remove the value at ``tokens``; returns (new document, removed value)."""
+    parent, last = _parent(doc, tokens, pointer), tokens[-1]
+    if isinstance(parent, dict):
+        if last not in parent:
+            raise PointerError(f"path {pointer!r} does not exist")
+        return doc, parent.pop(last)
+    if isinstance(parent, list):
+        return doc, parent.pop(array_index(last, pointer, len(parent), False))
+    raise PointerError(f"path {pointer!r} does not exist")
+
+
+def _apply_one(doc, op):
+    name, tokens, path = op.name, op.tokens, op.path
+    if name == "add":
+        return _add(doc, tokens, path, copy.deepcopy(op.value))
+    if name == "remove":
+        if not tokens:
+            raise op.fail("cannot remove the document root")
+        return _remove(doc, tokens, path)[0]
+    if name == "replace":
+        walk(doc, tokens, path)
+        if not tokens:
+            return copy.deepcopy(op.value)
+        parent = _parent(doc, tokens, path)
+        key = tokens[-1] if isinstance(parent, dict) else array_index(tokens[-1], path, len(parent), False)
+        parent[key] = copy.deepcopy(op.value)
+        return doc
+    if name == "test":
+        if not json_equal(walk(doc, tokens, path), op.value):
+            raise op.fail(f"test failed at {path!r}")
+        return doc
+    value = walk(doc, op.from_tokens, op.source)
+    if name == "copy":
+        return _add(doc, tokens, path, copy.deepcopy(value))
+    # move
+    if op.from_tokens == tokens:
+        return doc
+    if tokens[: len(op.from_tokens)] == op.from_tokens:
+        raise op.fail(f"cannot move {op.source!r} into its own child {path!r}")
+    doc, value = _remove(doc, op.from_tokens, op.source)
+    return _add(doc, tokens, path, value)
+
+
+def apply_patch(doc, ops, max_ops=100):
+    """Return ``doc`` with ``ops`` applied; ``doc`` and ``ops`` are not modified."""
+    if not isinstance(ops, list):
+        raise PatchError("patch must be a list of operations")
+    if len(ops) > max_ops:
+        raise PatchError(f"too many operations: {len(ops)} > {max_ops}")
+    parsed = [_check(i, op) for i, op in enumerate(ops)]
+    result = copy.deepcopy(doc)
+    for op in parsed:
+        try:
+            result = _apply_one(result, op)
+        except PointerError as exc:
+            raise op.fail(str(exc)) from None
+    return result
diff -ruN a/src/docstore/pointer.py b/src/docstore/pointer.py
--- a/src/docstore/pointer.py
+++ b/src/docstore/pointer.py
@@ -0,0 +1,68 @@
+"""JSON Pointer (RFC 6901 as specified for docstore).
+
+``parse_pointer`` turns pointer text into a token list, ``format_pointer`` turns
+a token list back into text, and ``resolve`` finds the value a pointer names.
+"""
+import re
+
+from .errors import PointerError
+
+_INDEX = re.compile(r"0|[1-9][0-9]*")
+_BAD_ESCAPE = re.compile(r"~(?![01])")
+
+
+def parse_pointer(text):
+    """Return the decoded tokens of ``text``; ``""`` is the whole document."""
+    if text == "":
+        return []
+    if not text.startswith("/"):
+        raise PointerError(f"pointer must start with '/': {text!r}")
+    if _BAD_ESCAPE.search(text):
+        raise PointerError(f"bad escape in pointer: {text!r}")
+    return [t.replace("~1", "/").replace("~0", "~") for t in text[1:].split("/")]
+
+
+def format_pointer(tokens):
+    """Return the pointer text of a token list."""
+    return "".join("/" + t.replace("~", "~0").replace("/", "~1") for t in tokens)
+
+
+def array_index(token, pointer, length, allow_end):
+    """Return the list position a token names on an array of ``length`` items.
+
+    ``allow_end`` (add) accepts ``-`` and an index equal to the length; both
+    mean "append" and give ``length``.
+    """
+    if token == "-":
+        if allow_end:
+            return length
+        raise PointerError(f"index '-' out of range in {pointer!r}")
+    if not _INDEX.fullmatch(token):
+        raise PointerError(f"invalid array index {token!r} in {pointer!r}")
+    index = int(token)
+    if index > length or (index == length and not allow_end):
+        raise PointerError(f"index {token!r} out of range in {pointer!r}")
+    return index
+
+
+def step(cur, token, pointer):
+    """Move one token down from ``cur``; raises PointerError when it cannot."""
+    if isinstance(cur, dict):
+        if token not in cur:
+            raise PointerError(f"path {pointer!r} does not exist")
+        return cur[token]
+    if isinstance(cur, list):
+        return cur[array_index(token, pointer, len(cur), False)]
+    raise PointerError(f"path {pointer!r} does not exist")
+
+
+def walk(doc, tokens, pointer):
+    cur = doc
+    for token in tokens:
+        cur = step(cur, token, pointer)
+    return cur
+
+
+def resolve(doc, pointer):
+    """Return the value ``pointer`` names inside ``doc`` (not a copy)."""
+    return walk(doc, parse_pointer(pointer), pointer)
