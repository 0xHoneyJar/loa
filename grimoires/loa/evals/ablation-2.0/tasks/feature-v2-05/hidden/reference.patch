--- a/src/docstore/delta.py
+++ b/src/docstore/delta.py
@@ -0,0 +1,86 @@
+"""Canonical structural diff (as specified for docstore): ``docstore.delta``.
+
+``diff(a, b)`` returns the JSON Patch operations that turn ``a`` into ``b``:
+objects recurse member by member in sorted key order, arrays keep a longest
+common subsequence of whole elements (the one whose index tuples into ``a``,
+then into ``b``, are lexicographically smallest), and any other difference is
+one ``replace``. ``strict_equal`` is the equality the diff uses.
+"""
+import copy
+
+from .pointer import format_pointer
+
+
+def strict_equal(a, b):
+    """Type-sensitive equality: null, bool, int, float, str, list, dict are distinct kinds."""
+    if type(a) is not type(b):
+        return False
+    if isinstance(a, list):
+        return len(a) == len(b) and all(strict_equal(x, y) for x, y in zip(a, b))
+    if isinstance(a, dict):
+        return a.keys() == b.keys() and all(strict_equal(a[k], b[k]) for k in a)
+    return a == b
+
+
+def keep_pairs(a, b):
+    """Return the (indexes into a, indexes into b) of the canonical common subsequence."""
+    m, n = len(a), len(b)
+    eq = [[strict_equal(a[i], b[j]) for j in range(n)] for i in range(m)]
+    # suffix[i][j]: length of a longest common subsequence of a[i:] and b[j:]
+    suffix = [[0] * (n + 1) for _ in range(m + 1)]
+    for i in range(m - 1, -1, -1):
+        for j in range(n - 1, -1, -1):
+            if eq[i][j]:
+                suffix[i][j] = suffix[i + 1][j + 1] + 1
+            else:
+                suffix[i][j] = max(suffix[i + 1][j], suffix[i][j + 1])
+    need = suffix[0][0]
+    keep_a, keep_b = [], []
+    i = j = 0
+    while need:
+        # the smallest a-index that can still start a completion of length `need`,
+        # matched with the smallest b-index that allows that completion
+        found = False
+        for ii in range(i, m):
+            for jj in range(j, n):
+                if eq[ii][jj] and suffix[ii + 1][jj + 1] >= need - 1:
+                    keep_a.append(ii)
+                    keep_b.append(jj)
+                    i, j, need, found = ii + 1, jj + 1, need - 1, True
+                    break
+            if found:
+                break
+    return keep_a, keep_b
+
+
+def _diff(a, b, tokens, out):
+    if strict_equal(a, b):
+        return
+    if isinstance(a, dict) and isinstance(b, dict):
+        for key in sorted(set(a) | set(b)):
+            path = tokens + [key]
+            if key not in b:
+                out.append({"op": "remove", "path": format_pointer(path)})
+            elif key not in a:
+                out.append({"op": "add", "path": format_pointer(path), "value": copy.deepcopy(b[key])})
+            else:
+                _diff(a[key], b[key], path, out)
+        return
+    if isinstance(a, list) and isinstance(b, list):
+        keep_a, keep_b = keep_pairs(a, b)
+        kept_a, kept_b = set(keep_a), set(keep_b)
+        for i in range(len(a) - 1, -1, -1):
+            if i not in kept_a:
+                out.append({"op": "remove", "path": format_pointer(tokens + [str(i)])})
+        for j in range(len(b)):
+            if j not in kept_b:
+                out.append({"op": "add", "path": format_pointer(tokens + [str(j)]), "value": copy.deepcopy(b[j])})
+        return
+    out.append({"op": "replace", "path": format_pointer(tokens), "value": copy.deepcopy(b)})
+
+
+def diff(a, b):
+    """Return the canonical list of operations turning ``a`` into ``b``."""
+    out = []
+    _diff(a, b, [], out)
+    return out
