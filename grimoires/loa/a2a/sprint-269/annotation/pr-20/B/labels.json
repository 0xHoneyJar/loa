    "H02": {"verdict": "defect", "not_defect_class": null, "group": "D2", "file": ".claude/hooks/safety/block-destructive-bash.sh", "anchor_lines": [190], "description": "The executable-target regex omits workflow files, makefiles, justfiles, package manifests, Dockerfiles and pre-commit/CI configs, so a heredoc writing destructive content into them is classified non-executing and its body is dropped from the scan.", "severity": "medium", "category": "security"},
