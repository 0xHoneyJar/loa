    "H09": {"verdict": "defect", "not_defect_class": null, "group": "D1", "file": ".claude/hooks/compliance/implement-gate.sh", "anchor_lines": [35, 36], "description": "PROJECT_ROOT defaults to the process cwd, which follows Claude's `cd`, so App-Zone detection and the .run state the gate trusts can be shifted to another directory.", "severity": "high", "category": "security"},
    "H10": {"verdict": "defect", "not_defect_class": null, "group": "D2", "file": ".claude/hooks/compliance/implement-gate.sh", "anchor_lines": [53, 55, 56, 57], "description": "When jq is missing, the payload cannot be parsed, or the tool is NotebookEdit (notebook_path), file_path comes out empty and the gate allows the write instead of asking.", "severity": "high", "category": "security"},
    "H11": {"verdict": "defect", "not_defect_class": null, "group": "D3", "file": ".claude/hooks/compliance/implement-gate.sh", "anchor_lines": [73, 76, 77, 78, 81, 89, 90, 97, 99], "description": "Path normalization is a textual prefix test, so /proc/self/cwd/src/x, //ROOT/src/x, ROOT/../name/src/x, a symlinked root or a case variant reaches an App-Zone file without an ask (and writes to the gate's own trust inputs are not checked).", "severity": "high", "category": "security"},
    "H12": {"verdict": "defect", "not_defect_class": null, "group": "D4", "file": ".claude/hooks/compliance/implement-gate.sh", "anchor_lines": [134, 228], "description": "The model-authored file_path is echoed raw to stderr, so control and bidi characters reach the operator's terminal.", "severity": "low", "category": "security"},
    "H13": {"verdict": "defect", "not_defect_class": null, "group": "D5", "file": ".claude/hooks/compliance/implement-gate.sh", "anchor_lines": [123, 127, 128, 129, 134, 135], "description": "In authoritative mode a model-authored tool_input.active_skill naming an implementation skill allows the App-Zone write outright, so the model can grant itself permission.", "severity": "high", "category": "security"},
    "H14": {"verdict": "not-defect", "not_defect_class": "follow-on", "group": "D7", "file": ".claude/hooks/compliance/implement-gate.sh", "anchor_lines": [], "description": "Adds the freshness helper used by the stale-state fix.", "severity": null, "category": null},
    "H15": {"verdict": "defect", "not_defect_class": null, "group": "D7", "file": ".claude/hooks/compliance/implement-gate.sh", "anchor_lines": [200, 202, 203], "description": "A simstim-state.json with phase implementation counts as active however old it is, so stale state permanently allows App-Zone writes.", "severity": "medium", "category": "security"},
    "H16": {"verdict": "defect", "not_defect_class": null, "group": "D7", "file": ".claude/hooks/compliance/implement-gate.sh", "anchor_lines": [209, 211, 212], "description": "A state.json with state RUNNING counts as active with no staleness check, so a leftover run state allows App-Zone writes indefinitely.", "severity": "medium", "category": "security"},
    "H17": {"verdict": "defect", "not_defect_class": null, "group": "D6", "file": ".claude/hooks/compliance/implement-gate.sh", "anchor_lines": [230, 135], "description": "The ask is emitted as top-level {\"decision\":\"ask\"}, which the PreToolUse contract does not accept (only approve|block), so the advisory ask is not honoured as an ask.", "severity": "high", "category": "contract"},
