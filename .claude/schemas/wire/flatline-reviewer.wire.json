{
  "title": "flatline-reviewer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "improvements",
    "summary",
    "no_findings_reason",
    "reviewed_sections"
  ],
  "properties": {
    "improvements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "rationale",
          "location",
          "priority",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "confidence": {
            "type": "number"
          }
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "no_findings_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewed_sections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
