{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "flatline-scorer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scores"
  ],
  "properties": {
    "scores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "score",
          "evaluation",
          "would_integrate"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "score": {
            "type": "integer"
          },
          "evaluation": {
            "type": "string"
          },
          "would_integrate": {
            "type": "boolean"
          }
        }
      }
    }
  }
}