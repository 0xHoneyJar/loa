+        '{"opt": (.hounfour.headless.agy_opt_in | (tag == "!!bool" and . == true)), "mode": (.hounfour.headless.mode // "")}',
+        configPath],
+      { encoding: "utf8", timeout: 5000, stdio: ["ignore", "pipe", "ignore"] },
+    );
