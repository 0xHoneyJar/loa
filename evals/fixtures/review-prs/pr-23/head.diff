+}
+
+@test "AG-4 a same-named file is overwritten by the hidden copy; a symlinked test dir is replaced" {
+  RD="$T/run"; make_run bf-py "$RD"
+  printf 'def test_basic():\n    assert True\n' > "$RD/sandbox/tests/test_slug.py"
