+  [ "$(G '.hidden_tests | "\(.passed)/\(.total)"')" = "5/7" ]
+  [ "$(G '.hidden_tests.failed_names | join(",")')" = "t6,t7" ]
+  RD="$T/run2"; make_run bf-py "$RD"
