+}
diff --git a/tests/unit/user-invoked-harness.bats b/tests/unit/user-invoked-harness.bats
new file mode 100644
index 00000000..ab2479bd
--- /dev/null
+++ b/tests/unit/user-invoked-harness.bats
@@ -0,0 +1,176 @@
+#!/usr/bin/env bats
+# =============================================================================
+# user-invoked-harness.bats: does `disable-model-invocation: true` hide a
+# command from the model's Skill tool? (FR-8, SDD D-8.4)
+# =============================================================================
+# One live `claude -p` run in a throwaway project holding two fixture commands:
+# `fixture-hidden` (flagged) and `fixture-visible` (control, unflagged). The
+# live run gets the Skill tool only, so it cannot read the fixture bodies or
+# run anything else, and it never sees a real Loa command.
+#
+# Outcomes of the live test:
+#   pass   the control ran (its marker reached the stream) and the hidden
+#          command did not (no Skill tool_use for it, or an error result,
+#          and its marker is absent everywhere)
+#   fail   the hidden marker reached the stream: the flag does not hide the
+#          command, so FR-8 is lint-only and G-7 partial
+#   skip   no `claude` on PATH; LOA_HARNESS_CHECK=0; CLI error, timeout or
+#          unparsable output; or the control never ran (inconclusive)
+# Set LOA_HARNESS_OUT=<file> to keep the raw stream-json as evidence.
+# The classifier is also exercised offline against canned streams.
+
+HIDDEN_MARK="HIDDEN-RAN"
+VISIBLE_MARK="VISIBLE-RAN"
+
+# classify_stream <stream-json file>
+# Prints one of: verified | flag-does-not-hide | inconclusive-control | unparsable
+classify_stream() {
+    local stream="$1"
+    if ! jq -e -s 'length > 0' "$stream" >/dev/null 2>&1; then
+        echo "unparsable"
+        return 0
+    fi
+    # Marker text anywhere in a tool result, an injected user message or the
+    # final result means that command's body was loaded into the session.
+    local hidden_seen visible_seen
+    hidden_seen="$(jq -r -s --arg m "$HIDDEN_MARK" \
+        '[.[] | select(.type == "user" or .type == "result" or .type == "assistant") | tostring | contains($m)] | any' "$stream")"
+    visible_seen="$(jq -r -s --arg m "$VISIBLE_MARK" \
+        '[.[] | select(.type == "user" or .type == "result" or .type == "assistant") | tostring | contains($m)] | any' "$stream")"
+    if [[ "$hidden_seen" == "true" ]]; then
+        echo "flag-does-not-hide"
+    elif [[ "$visible_seen" != "true" ]]; then
+        echo "inconclusive-control"
+    else
+        echo "verified"
+    fi
+}
+
+# skill_calls <stream-json file>: one line per Skill tool_use, "<name>\t<is_error>"
+skill_calls() {
+    jq -r -s '
+      ([.[] | select(.type == "user") | .message.content[]? | select(.type? == "tool_result")
+         | {key: .tool_use_id, value: ((.is_error // false) | tostring)}] | from_entries) as $res
+      | .[] | select(.type == "assistant") | .message.content[]?
+      | select(.type? == "tool_use" and .name == "Skill")
+      | "\(.input.skill // .input.command // .input.name // "?")\t\($res[.id] // "no-result")"' "$1"
+}
+
+write_fixture_project() {
+    local dir="$1"
+    mkdir -p "$dir/.claude/commands"
+    git -C "$dir" init -q
+    cat > "$dir/.claude/commands/fixture-hidden.md" <<'EOF'
+---
+name: fixture-hidden
+description: fixture
+disable-model-invocation: true
+---
+
+Reply with the single word HIDDEN-RAN
+EOF
+    cat > "$dir/.claude/commands/fixture-visible.md" <<'EOF'
+---
+name: fixture-visible
+description: fixture
+---
+
+Reply with the single word VISIBLE-RAN
+EOF
+}
+
+# ---------------------------------------------------------------------------
+# Offline: the classifier over canned streams (always runs)
+# ---------------------------------------------------------------------------
+
+@test "classifier: hidden refused, control ran -> verified" {
+    local s="$BATS_TEST_TMPDIR/ok.jsonl"
+    cat > "$s" <<'EOF'
+{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t1","name":"Skill","input":{"skill":"fixture-hidden"}}]}}
+{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"t1","is_error":true,"content":"Unknown skill: fixture-hidden"}]}}
+{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t2","name":"Skill","input":{"skill":"fixture-visible"}}]}}
+{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"t2","content":"Launching skill: fixture-visible"}]}}
+{"type":"user","message":{"content":[{"type":"text","text":"Reply with the single word VISIBLE-RAN"}]}}
+{"type":"result","subtype":"success","result":"VISIBLE-RAN"}
+EOF
+    run classify_stream "$s"
+    [ "$output" = "verified" ]
+    run skill_calls "$s"
+    [[ "$output" == *$'fixture-hidden\ttrue'* ]]
+    [[ "$output" == *$'fixture-visible\tfalse'* ]]
+}
+
+@test "classifier: hidden body reached the stream -> flag-does-not-hide" {
+    local s="$BATS_TEST_TMPDIR/leak.jsonl"
+    cat > "$s" <<'EOF'
+{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t1","name":"Skill","input":{"skill":"fixture-hidden"}}]}}
+{"type":"user","message":{"content":[{"type":"text","text":"Reply with the single word HIDDEN-RAN"}]}}
+{"type":"result","subtype":"success","result":"HIDDEN-RAN VISIBLE-RAN"}
+EOF
+    run classify_stream "$s"
+    [ "$output" = "flag-does-not-hide" ]
+}
+
+@test "classifier: control never ran -> inconclusive-control" {
+    local s="$BATS_TEST_TMPDIR/noctl.jsonl"
+    cat > "$s" <<'EOF'
+{"type":"result","subtype":"error_max_turns","result":""}
+EOF
+    run classify_stream "$s"
+    [ "$output" = "inconclusive-control" ]
+}
+
+@test "classifier: garbage output -> unparsable" {
+    local s="$BATS_TEST_TMPDIR/bad.jsonl"
+    printf 'not json at all\n' > "$s"
+    run classify_stream "$s"
+    [ "$output" = "unparsable" ]
+}
+
+# ---------------------------------------------------------------------------
+# Live: one claude -p run against the fixture project
+# ---------------------------------------------------------------------------
+
+@test "live harness: disable-model-invocation hides a command from the Skill tool" {
+    if [[ "${LOA_HARNESS_CHECK:-1}" == "0" ]]; then
+        skip "LOA_HARNESS_CHECK=0"
+    fi
+    if ! command -v claude >/dev/null 2>&1; then
+        skip "claude CLI not on PATH"
+    fi
+    if ! command -v jq >/dev/null 2>&1 || ! command -v timeout >/dev/null 2>&1; then
+        skip "jq or timeout missing"
+    fi
+
+    local proj="$BATS_TEST_TMPDIR/proj"
+    write_fixture_project "$proj"
+    local out="$BATS_TEST_TMPDIR/stream.jsonl"
+    local prompt="Use the Skill tool to invoke the skill named fixture-hidden, then use the Skill tool to invoke the skill named fixture-visible. Follow whatever each skill tells you, and report each tool result verbatim."
+
+    local rc=0
+    ( cd "$proj" && env -u CLAUDECODE timeout 180 claude -p --max-turns 3 \
+        --tools Skill --output-format stream-json --verbose \
+        --no-session-persistence "$prompt" ) > "$out" 2>"$BATS_TEST_TMPDIR/stderr" || rc=$?
+    if [[ -n "${LOA_HARNESS_OUT:-}" ]]; then
+        cp "$out" "$LOA_HARNESS_OUT"
+    fi
+
+    local verdict
+    verdict="$(classify_stream "$out")"
+    echo "verdict=$verdict rc=$rc" >&3
+    skill_calls "$out" 2>/dev/null | sed 's/^/skill_call: /' >&3 || true
+
+    case "$verdict" in
+        unparsable)
+            skip "CLI error or unparsable output (rc=$rc): $(head -c 300 "$BATS_TEST_TMPDIR/stderr")" ;;
+        inconclusive-control)
+            skip "inconclusive: control not invocable (rc=$rc)" ;;
+        flag-does-not-hide)
+            echo "flag does not hide the command: FR-8 is lint-only, G-7 partial" >&2
+            return 1 ;;
+        verified)
+            return 0 ;;
+    esac
+    echo "unknown verdict: $verdict" >&2
+    return 1
+}
diff --git a/tests/unit/validate-artifact.bats b/tests/unit/validate-artifact.bats
index 5c53aa41..3a677c41 100644
--- a/tests/unit/validate-artifact.bats
+++ b/tests/unit/validate-artifact.bats
@@ -607,3 +607,232 @@ EOF2
     run grep -nE "printf '%s' \"\\\$[a-z_]+\" \| grep -q" "$SCRIPT"
     [ "$status" -eq 1 ]
 }
+
+# =============================================================================
+# decisions (the decision ledger) + the prd tag-to-row rule + the sdd DEC column
+# =============================================================================
+# Hermetic: a temp project under BATS_TEST_TMPDIR holds a copy of the validator, the ledger writer
+# and compat-lib, so the host's run state (a RUNNING run makes the context unattended) never leaks
+# in. Fixtures are written by the writer, then mutated by yq as a hand edit would be.
+
+_dec_skip_unless_tools() {
+    skip_if_no_jq
+    [[ "$(yq --version 2>&1)" == *mikefarah*"version v4."* ]] || skip "Mike Farah yq v4 not installed"
+}
+
+_dec_project() {
+    unset LOA_UNATTENDED LOA_FLATLINE_MODE CI GITHUB_ACTIONS LOA_HOOK_CONTEXT CLAUDE_SESSION_ID CLAUDE_CODE_SESSION_ID
+    DP="$BATS_TEST_TMPDIR/dproj"
+    mkdir -p "$DP/.claude/scripts/lib" "$DP/grimoires/loa"
+    cp "$SCRIPT" "$PROJECT_ROOT/.claude/scripts/compat-lib.sh" "$DP/.claude/scripts/"
+    [[ -f "$PROJECT_ROOT/.claude/scripts/pii-filter.sh" ]] && cp "$PROJECT_ROOT/.claude/scripts/pii-filter.sh" "$DP/.claude/scripts/"
+    cp "$PROJECT_ROOT/.claude/scripts/lib/dec-write-lib.sh" "$DP/.claude/scripts/lib/"
+    { sed '/^schema_version:/,$d' "$PROJECT_ROOT/grimoires/loa/decisions.yaml"; printf 'schema_version: 1\ndecisions: []\n'; } > "$DP/grimoires/loa/decisions.yaml"
+    git -C "$DP" init -q
+    DV="$DP/.claude/scripts/validate-artifact.sh"
+    DW="$DP/.claude/scripts/lib/dec-write-lib.sh"
+    DL="$DP/grimoires/loa/decisions.yaml"
+    DALT='{"option":"keep sequential","rejected_because":"slow"}'
+}
+# _dec_rows N: N proposed rows in the fixture ledger; DEC-0001 confirmed by the operator when $1 == confirm
+_dec_new_prop() { bash "$DW" new --file "$DL" --summary "${1:-rounds is the default}" --phase discovery --category scope --recorded-by t \
+    --source "${2:-prd.md#e (D1)}" --status proposed --decision d --rationale r --alternative-json "$DALT" --cycle cycle-128 --quiet; }
+_dec_confirm() { bash "$DW" confirm --file "$DL" --id "$1" --recorded-by decisions-command --evidence "cli:2026-10-13T12:00:00Z" --answer-ref "cli:2026-10-13T12:00:00Z" --quiet; }
+
+@test "validate-artifact decisions: the live ledger passes" {
+    _dec_skip_unless_tools
+    run "$SCRIPT" --type decisions --file "$PROJECT_ROOT/grimoires/loa/decisions.yaml"
+    [ "$status" -eq 0 ]
+}
+
+@test "validate-artifact decisions: a writer-built ledger passes (open, proposed, decided, rejected, superseded rows)" {
+    _dec_skip_unless_tools; _dec_project
+    _dec_new_prop >/dev/null; _dec_new_prop >/dev/null; _dec_new_prop >/dev/null
+    _dec_confirm DEC-0001
+    bash "$DW" reject --file "$DL" --id DEC-0002 --rationale no --follow-up bd-x --recorded-by t --quiet
+    bash "$DW" supersede --file "$DL" --id DEC-0001 --summary s2 --phase discovery --category scope --recorded-by decisions-command --source s --decision d --rationale r --alternative-json "$DALT" --quiet >/dev/null
+    run "$DV" --type decisions --file "$DL"
+    [ "$status" -eq 0 ]
+    [[ "$output" == *"4 decision rows"* ]]
+}
+
+# _dec_bad <yq mutation> <expected message fragment> [--base]
+_dec_bad() {
+    local expr="$1" want="$2" base="${3:-}"
+    cp "$DL" "$BATS_TEST_TMPDIR/base.yaml"
+    yq -i "$expr" "$DL"
+    if [[ "$base" == "--base" ]]; then run "$DV" --type decisions --file "$DL" --base-file "$BATS_TEST_TMPDIR/base.yaml"
+    else run "$DV" --type decisions --file "$DL"; fi
+    [ "$status" -eq 1 ] || { echo "expected exit 1 for: $expr; got $status: $output"; return 1; }
+    [[ "$output" == *"$want"* ]] || { echo "missing [$want] in: $output"; return 1; }
+    cp "$BATS_TEST_TMPDIR/base.yaml" "$DL"
+}
+
+@test "validate-artifact decisions: each negative fixture exits 1 with its reason" {
+    _dec_skip_unless_tools; _dec_project
+    _dec_new_prop >/dev/null; _dec_new_prop >/dev/null; _dec_confirm DEC-0001
+    _dec_bad 'del(.decisions[1].decided_by)' "DEC-0002: missing field decided_by"
+    _dec_bad '.decisions += [.decisions[1]]' "duplicate id DEC-0002"
+    _dec_bad '.decisions[1].id = "PEND-0a1b2c3d"' "PEND- id in the live ledger"
+    _dec_bad '.decisions[0].transitions[1].evidence = ""' "the -> decided transition has no evidence"
+    _dec_bad '.decisions[0].decided_by_ref = null' "decided_by operator needs an operator answer reference"
+    _dec_bad '.decisions[0].transitions[1].by = "agent:run-mode"' "needs by operator:*"
+    _dec_bad '.decisions[1].decided_by = "agent"' "decided_by must stay null until /decisions confirm"
+    _dec_bad '.decisions[1].decided_by_ref = "trust me"' "does not match the ref grammar"
+    _dec_bad '.schema_version = 2' "unknown schema_version 2"
+    _dec_bad '.decisions[1].rationale = "see https://example.com/x"' "a URL in free text"
+    _dec_bad '.decisions[1].phase = "whenever"' "phase \"whenever\" is not one of"
+    _dec_bad '.decisions[1].alternatives_considered = []' "at least one alternatives_considered entry"
+    _dec_bad '.decisions[1].transitions[0].from = "open"' "the first transition must be null -> open|proposed"
+}
+
+@test "validate-artifact decisions: an illegal transition (rejected -> decided) fails" {
+    _dec_skip_unless_tools; _dec_project
+    _dec_new_prop >/dev/null
+    bash "$DW" reject --file "$DL" --id DEC-0001 --rationale no --follow-up bd-x --recorded-by t --quiet
+    _dec_bad '.decisions[0].transitions += [{"at":"2026-10-14T00:00:00Z","from":"rejected","to":"decided","by":"operator:decisions-command","evidence":"cli:2026-10-14T00:00:00Z"}] | .decisions[0].status = "decided" | .decisions[0].decided_by = "operator" | .decisions[0].decided_by_ref = "cli:2026-10-14T00:00:00Z"' 'illegal transition "rejected" -> "decided"'
+    _dec_bad '.decisions[0].follow_up = null' "a rejected row needs rejection_rationale and follow_up"
+}
+
+@test "validate-artifact decisions: content edits, dropped rows and rewritten history fail against the base; an appended transition passes" {
+    _dec_skip_unless_tools; _dec_project
