+#!/usr/bin/env bash
+# =============================================================================
+# fingerprint.sh — toolchain fingerprint for ablation runs (cycle-130 FR-4, SDD A11 / DEC-0389)
+#
+# Prints `fp:<sha256>` over the LC_ALL=C-sorted `tool=version` lines of the
+# toolchain an ablation run depends on (claude, codex, python3, node, yq, jq,
+# bats, git, docker) plus `source_tree=<HEAD of --source-tree>`. A tool that is
+# not installed reads `tool=absent`, so a missing tool changes the fingerprint
+# instead of failing the run. The value fills `image_digest` in host mode and
+# `fingerprint` in every mode (MANIFEST.json, pipeline.json, runs.jsonl). It reads the
+# HOST toolchain: in container mode the phases run on the image's toolchain, and the
+# image digest (not this value) identifies the batch's versions (on 2026-10-15 the host
+# CLI was 2.1.300 while Dockerfile.ablation pins 2.1.299).
+#
+# Usage:
+#   fingerprint.sh [--source-tree DIR] [--claude-bin B] [--bats-bin B] [--json]
+#
+# Options:
+#   --source-tree DIR  the pinned Loa tree; its `git rev-parse HEAD` is folded in
+#                      (`none` when absent or not a git tree)
+#   --claude-bin B     the CLI executable (default: $EVAL_CLAUDE_BIN, else claude)
+#   --bats-bin B       bats executable (default: bats on PATH, else the operator's
+#                      ~/.local/dotfiles/tools/diff-so-fancy/test/bats/bin/bats)
+#   --json             print {fingerprint, tools{}, source_tree, lines[]} instead
+#
+# Exit codes:
+#   0  printed
+#   2  usage error
+#
+# Tested by evals/tests/pipeline-run.bats (fingerprint cases).
+# =============================================================================
+set -euo pipefail
+export LC_ALL=C
+
+# Hashing is Python hashlib: no harness script sources .claude/ code (eval.yml
+# "Validate grader trust boundary").
+
+SOURCE_TREE=""
+CLAUDE_BIN="${EVAL_CLAUDE_BIN:-claude}"
+BATS_BIN="${LOA_EVAL_BATS_BIN:-}"
+JSON=false
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --source-tree) SOURCE_TREE="${2:?--source-tree needs a value}"; shift 2 ;;
+    --claude-bin)  CLAUDE_BIN="${2:?--claude-bin needs a value}"; shift 2 ;;
+    --bats-bin)    BATS_BIN="${2:?--bats-bin needs a value}"; shift 2 ;;
+    --json)        JSON=true; shift ;;
+    -h|--help)     sed -n '2,28p' "$0"; exit 0 ;;
+    *) echo "fingerprint.sh: unknown argument: $1" >&2; exit 2 ;;
+  esac
+done
+if [[ -z "$BATS_BIN" ]]; then
+  if command -v bats >/dev/null 2>&1; then BATS_BIN=bats
+  else BATS_BIN="$HOME/.local/dotfiles/tools/diff-so-fancy/test/bats/bin/bats"; fi
+fi
+
+# first line of `<bin> <args>`, whitespace collapsed; `absent` when not runnable
+tool_version() {  # tool_version <bin> <args...>
+  local bin="$1"; shift
+  if ! command -v "$bin" >/dev/null 2>&1 && [[ ! -x "$bin" ]]; then printf 'absent'; return 0; fi
+  local out
+  out="$("$bin" "$@" 2>&1 < /dev/null || true)"
+  out="$(printf '%s\n' "$out" | sed -n '1p' | tr -s ' \t' ' ' | sed 's/^ //; s/ $//')"
+  [[ -n "$out" ]] || out="unknown"
+  printf '%s' "$out"
+}
+
+lines="$(
+  {
+    printf 'claude=%s\n'  "$(tool_version "$CLAUDE_BIN" --version)"
+    printf 'codex=%s\n'   "$(tool_version codex --version)"
+    printf 'python3=%s\n' "$(tool_version python3 --version)"
+    printf 'node=%s\n'    "$(tool_version node --version)"
+    printf 'yq=%s\n'      "$(tool_version yq --version)"
+    printf 'jq=%s\n'      "$(tool_version jq --version)"
+    printf 'bats=%s\n'    "$(tool_version "$BATS_BIN" --version)"
+    printf 'git=%s\n'     "$(tool_version git --version)"
+    printf 'docker=%s\n'  "$(tool_version docker --version)"
+  } | LC_ALL=C sort
+)"
+src="none"
+if [[ -n "$SOURCE_TREE" ]]; then
+  src="$(git -C "$SOURCE_TREE" rev-parse HEAD 2>/dev/null || echo none)"
+fi
+lines="$lines"$'\n'"source_tree=$src"
+digest="$(printf '%s\n' "$lines" | python3 -I -c 'import hashlib, sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())')"
+fp="fp:$digest"
+
+if [[ "$JSON" == true ]]; then
+  printf '%s\n' "$lines" | jq -Rn --arg fp "$fp" --arg src "$src" '
+    [inputs | select(length > 0)] as $l
+    | {fingerprint: $fp, source_tree: $src, lines: $l,
+       tools: ($l | map(select(startswith("source_tree=") | not) | capture("^(?<k>[^=]+)=(?<v>.*)$") | {(.k): .v}) | add)}'
+else
+  printf '%s\n' "$fp"
+fi
diff --git a/evals/harness/freeze.sh b/evals/harness/freeze.sh
new file mode 100755
index 00000000..a8011a78
--- /dev/null
+++ b/evals/harness/freeze.sh
@@ -0,0 +1,124 @@
+#!/usr/bin/env bash
+# =============================================================================
+# freeze.sh — cycle-130 ablation suite freeze (SDD §5.13, DEC-0404, DEC-0414)
+#
+# Writes or verifies <root>/MANIFEST.sha256, the suite's frozen identity: one
+# "<sha256>  <relpath>" line per file under <root>/tasks/ (and <root>/smoke/
+# with --smoke), relpath relative to the root, LC_ALL=C sorted, sha256 (Python
+# hashlib: no harness script sources .claude/ code, eval.yml trust boundary).
+# validate-suite.sh runs first; an invalid suite is never frozen or accepted.
+#
+# Usage:
+#   freeze.sh [--root DIR] [--smoke] [--check] [--allow-partial] [--suite-file F]
+#
+#   --root DIR        suite root (default grimoires/loa/evals/ablation-2.0)
+#   --smoke           cover smoke/ too (passed to the validator as well)
+#   --check           recompute and compare with MANIFEST.sha256; write nothing
+#   --allow-partial   passed to validate-suite.sh (fewer than four tasks per type)
+#   --suite-file F    passed to validate-suite.sh
+#
+# Output: `freeze: wrote MANIFEST.sha256 (N files, sha256 <digest of the manifest>)`
+# or `freeze: OK — N files match MANIFEST.sha256 (sha256 …)`; on drift every
+# changed / added / removed path on its own line.
+#
+# Exit: 0 written / matches; 1 drift, missing manifest under --check, or the
+#       validator found violations; 2 usage.
+# Tested by evals/tests/freeze.bats.
+# =============================================================================
+set -euo pipefail
+export LC_ALL=C
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
+
+ROOT="$REPO_ROOT/grimoires/loa/evals/ablation-2.0"
+CHECK=false SMOKE=false
+VARGS=()
+
+usage() { sed -n '2,/^# =====.*$/p' "$0" | sed -n '2,26p' | sed 's/^# \{0,1\}//' >&2; exit 2; }
+die() { echo "freeze: $*" >&2; exit 2; }
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --root) ROOT="${2:-}"; shift 2 ;;
+    --smoke) SMOKE=true; VARGS+=(--smoke); shift ;;
+    --check) CHECK=true; shift ;;
+    --allow-partial) VARGS+=(--allow-partial); shift ;;
+    --suite-file) [[ -n "${2:-}" ]] || die "--suite-file needs a path"; VARGS+=(--suite-file "$2"); shift 2 ;;
+    --help|-h) usage ;;
+    *) die "unknown option: $1 (see --help)" ;;
+  esac
+done
+[[ -n "$ROOT" && -d "$ROOT" ]] || die "suite root not found: ${ROOT:-<empty>}"
+ROOT="$(cd "$ROOT" && pwd)"
+MANIFEST="$ROOT/MANIFEST.sha256"
+
+vrc=0
+"$SCRIPT_DIR/validate-suite.sh" --root "$ROOT" ${VARGS[@]+"${VARGS[@]}"} || vrc=$?
+if [[ $vrc -eq 1 ]]; then echo "freeze: refused — the suite does not validate" >&2; exit 1; fi
+[[ $vrc -eq 0 ]] || die "validate-suite.sh failed (exit $vrc)"
+
+# compute_manifest <out> — the manifest body for the current tree.
+compute_manifest() {
+  local out="$1" list dirs=(tasks)
+  [[ "$SMOKE" == "true" ]] && dirs+=(smoke)
+  list="$(mktemp "${TMPDIR:-/tmp}/freeze-list.XXXXXX")"
+  local d
+  for d in "${dirs[@]}"; do
+    [[ -d "$ROOT/$d" ]] || continue
+    ( cd "$ROOT" && find "$d" -type f -print )
+  done | LC_ALL=C sort > "$list"
+  if grep -q '\\' "$list"; then rm -f "$list"; die "a path under the suite holds a backslash"; fi
+  python3 -I - "$ROOT" "$list" > "$out" <<'PY' || { rm -f "$list"; die "hashing failed"; }
+import hashlib, os, sys
+root, listing = sys.argv[1], sys.argv[2]
+for rel in open(listing, encoding="utf-8").read().splitlines():
+    if not rel:
+        continue
+    h = hashlib.sha256()
+    with open(os.path.join(root, rel), "rb") as f:
+        for b in iter(lambda: f.read(1 << 20), b""):
+            h.update(b)
+    print(h.hexdigest() + "  " + rel)
+PY
+  rm -f "$list"
+}
+digest_of() { python3 -I -c 'import hashlib, sys; print(hashlib.sha256(open(sys.argv[1], "rb").read()).hexdigest())' "$1"; }
+
+TMP="$(mktemp "${TMPDIR:-/tmp}/freeze.XXXXXX")"
+trap 'rm -f "$TMP"' EXIT
+compute_manifest "$TMP"
+n="$(grep -c . "$TMP" || true)"
+
+if [[ "$CHECK" == "true" ]]; then
+  [[ -f "$MANIFEST" ]] || { echo "freeze: no MANIFEST.sha256 in $ROOT (run freeze.sh first)" >&2; exit 1; }
+  if cmp -s "$TMP" "$MANIFEST"; then
+    echo "freeze: OK — $n files match MANIFEST.sha256 (sha256 $(digest_of "$MANIFEST"))"
+    exit 0
+  fi
+  echo "freeze: DRIFT against $MANIFEST:"
+  python3 -I - "$MANIFEST" "$TMP" <<'PY'
+import sys
+def load(p):
+    m = {}
+    for line in open(p, encoding="utf-8"):
+        line = line.rstrip("\n")
+        if line:
+            h, _, rel = line.partition("  ")
+            m[rel] = h
+    return m
+old, new = load(sys.argv[1]), load(sys.argv[2])
+for rel in sorted(set(old) | set(new)):
+    if rel not in new:
+        print(f"  removed  {rel}")
+    elif rel not in old:
+        print(f"  added    {rel}")
+    elif old[rel] != new[rel]:
+        print(f"  changed  {rel}")
+PY
+  exit 1
+fi
+
+cp "$TMP" "$MANIFEST.tmp" && mv "$MANIFEST.tmp" "$MANIFEST"
+echo "freeze: wrote MANIFEST.sha256 ($n files, sha256 $(digest_of "$MANIFEST"))"
+exit 0
