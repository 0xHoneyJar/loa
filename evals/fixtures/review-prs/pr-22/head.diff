+++ b/evals/tests/fixtures/claude-stub-pipeline.sh
@@ -0,0 +1,113 @@
+#!/usr/bin/env bash
+# claude-stub-pipeline.sh — stand-in for the `claude` CLI in evals/tests/pipeline-run.bats.
+# One invocation = one pipeline phase. The phase is read from the prompt's first
+# line (`# Phase: <NAME>`); the stub records what the executor gave it and emits a
+# stream-json transcript with a system/init event (session_id), per-turn
+# assistant events carrying usage, and a result event.
+#   STUB_LOG_DIR            per call: call-<n>.argv (NUL-separated), call-<n>.env
+#                           (`env` output), call-<n>.fds (ls /proc/self/fd), call-<n>.phase,
+#                           call-<n>.pwd. The executor's `env -i` strips these
+#                           controls, so tests reach the stub through a wrapper that
+#                           records pending.env / pending.fds and then loads them.
+#   STUB_COST_<PHASE>       result total_cost_usd (default 0.5)
+#   STUB_TURNS_<PHASE>      assistant turns to emit (default 2)
+#   STUB_TURN_OUT_<PHASE>   output tokens per turn (default 100)
+#   STUB_TURN_SLEEP         seconds between turns (default 0)
+#   STUB_SLEEP_<PHASE>      seconds to sleep before the result event
+#   STUB_EXIT_<PHASE>       exit code (default 0)
+#   STUB_SELF_KILL_<PHASE>  1: SIGTERM itself mid-phase (a phase killed from outside)
+#   STUB_VERDICT_REVIEW / STUB_VERDICT_AUDIT  APPROVED (default) | CHANGES_REQUIRED
+#   STUB_MODEL_USED_<PHASE> model id reported in modelUsage (default: --model)
+#   STUB_REFUSAL_<PHASE>    1: emit a system/model_refusal_fallback event
+#   STUB_DOT_CLAUDE_WRITE_<PHASE>  1: emit a Write tool_use under .claude/
+#   STUB_LEDGER_USD_<PHASE> append a cost-ledger row of that many USD to
+#                           $LOA_COST_LEDGER_PATH and one MODELINV row to
+#                           $LOA_MODELINV_LOG_PATH (a cheval voice call); the row's
+#                           calling_primitive / effort / effort_effective come from
+#                           STUB_PRIMITIVE_<PHASE>, STUB_HOP_EFFORT_<PHASE>,
+#                           STUB_HOP_EFFECTIVE_<PHASE>
+set -euo pipefail
+if [[ "${1:-}" == "--version" ]]; then echo "2.1.299 (Claude Code) stub"; exit 0; fi
+
+prompt="" model="" resume=""
+args=("$@")
+i=0
+while [[ $i -lt ${#args[@]} ]]; do
+  case "${args[$i]}" in
+    -p) prompt="${args[$((i + 1))]}"; i=$((i + 1)) ;;
+    --model) model="${args[$((i + 1))]}"; i=$((i + 1)) ;;
+    --resume) resume="${args[$((i + 1))]}"; i=$((i + 1)) ;;
+  esac
+  i=$((i + 1))
+done
+phase="$(printf '%s\n' "$prompt" | sed -n '1s/^# Phase: //p')"
+[[ -n "$phase" ]] || phase=UNKNOWN
+
+if [[ -n "${STUB_LOG_DIR:-}" ]]; then
+  mkdir -p "$STUB_LOG_DIR"
+  n=1; while [[ -e "$STUB_LOG_DIR/call-$n.argv" ]]; do n=$((n + 1)); done
+  printf '%s\0' "$@" > "$STUB_LOG_DIR/call-$n.argv"
+  # the executor runs the CLI under `env -i`, so the bats wrapper (make_wrappers in
+  # pipeline-run.bats) captures the environment and descriptors it was given into
+  # pending.* BEFORE loading the stub's controls; without a wrapper, capture here
+  if [[ -f "$STUB_LOG_DIR/pending.env" ]]; then mv "$STUB_LOG_DIR/pending.env" "$STUB_LOG_DIR/call-$n.env"
+  else env | sed -E 's/^(AWS_BEARER_TOKEN_BEDROCK)=.*/\1=<set>/' > "$STUB_LOG_DIR/call-$n.env"; fi   # key name only
+  if [[ -f "$STUB_LOG_DIR/pending.fds" ]]; then mv "$STUB_LOG_DIR/pending.fds" "$STUB_LOG_DIR/call-$n.fds"
+  else ls "/proc/$$/fd" > "$STUB_LOG_DIR/call-$n.fds" 2>/dev/null || true; fi
+  printf '%s\n' "$phase" > "$STUB_LOG_DIR/call-$n.phase"
+  printf '%s\n' "$PWD" > "$STUB_LOG_DIR/call-$n.pwd"
+fi
+
+v() { local k="$1_$phase" d="$2"; printf '%s' "${!k:-$d}"; }
+cost="$(v STUB_COST 0.5)"; turns="$(v STUB_TURNS 2)"; out_tok="$(v STUB_TURN_OUT 100)"
+used="$(v STUB_MODEL_USED "$model")"
+if [[ -n "$resume" ]]; then sid="$resume"; else sid="sess-$phase-$$-$RANDOM"; fi
+
+a2a="grimoires/loa/a2a/sprint-1"
+case "$phase" in
+  PLAN) mkdir -p grimoires/loa; printf '# Sprint plan\n\n## Success Criteria\nx\n' > grimoires/loa/sprint.md ;;
+  IMPLEMENT|FIX) printf '%s\n' "$phase" >> work.txt; mkdir -p "$a2a"; printf 'report %s\n' "$phase" > "$a2a/reviewer.md" ;;
+  BARE) printf '%s\n' "$phase" >> work.txt ;;
+  REVIEW|AUDIT)
+    if [[ "$phase" == REVIEW ]]; then vv="${STUB_VERDICT_REVIEW:-APPROVED}" f="$a2a/engineer-feedback.md" gate=review t=code_review
+    else vv="${STUB_VERDICT_AUDIT:-APPROVED}" f="$a2a/auditor-sprint-feedback.md" gate=audit t=security_audit; fi
+    mkdir -p "$a2a"
+    printf 'feedback\n<!-- LOA-VERDICT {"gate":"%s","verdict":"%s","counts":{"critical":0,"high":0,"medium":0,"low":0}} -->\n' "$gate" "$vv" > "$f"
+    # the dissent envelope says what the sandbox config planned (A3 evidence)
+    cv="$(yq -r ".flatline_protocol.$t.companion_voice" .loa.config.yaml 2>/dev/null || echo null)"
+    planned=true; [[ "$cv" == false ]] && planned=false
+    jq -n --argjson p "$planned" '{verdict_quality: {status: "APPROVED", voices_planned: (if $p then 2 else 1 end),
+      voices_succeeded: (if $p then 2 else 1 end)}, metadata: {companion_voice: {planned: $p}}}' \
+      > "$a2a/adversarial-$gate.json"
+    ;;
+esac
+
+led="$(v STUB_LEDGER_USD 0)"
+if [[ "$led" != 0 && -n "${LOA_COST_LEDGER_PATH:-}" ]]; then
+  jq -cn --argjson u "$led" '{ts: "2026-10-15T00:00:00Z", agent: "flatline-orchestrator", cost_micro_usd: ($u * 1000000 | round)}' >> "$LOA_COST_LEDGER_PATH"
+  prim_d="adversarial-$(printf '%s' "$phase" | tr 'A-Z' 'a-z')"
+  prim="$(v STUB_PRIMITIVE "$prim_d")"; heff="$(v STUB_HOP_EFFORT xhigh)"; heffv="$(v STUB_HOP_EFFECTIVE "$heff")"
+  jq -cn --arg p "$prim" --arg e "$heff" --arg ee "$heffv" --argjson u "$led" \
+    '{schema_version: "1.1.0", primitive_id: "MODELINV", event_type: "model.invoke.complete", ts_utc: "2026-10-15T00:00:00.000000Z",
+      payload: {models_requested: ["openai:gpt-5.5"], models_succeeded: ["openai:gpt-5.5"], calling_primitive: $p,
+                effort: $e, effort_effective: $ee, cost_micro_usd: ($u * 1000000 | round)}}' >> "${LOA_MODELINV_LOG_PATH:-/dev/null}"
+fi
+printf '{"type":"system","subtype":"init","session_id":"%s","model":"%s"}\n' "$sid" "$model"
+if [[ "$(v STUB_REFUSAL 0)" == 1 ]]; then
+  printf '{"type":"system","subtype":"model_refusal_fallback","original_model":"%s","fallback_model":"other-model","api_refusal_category":"x"}\n' "$model"
+fi
+if [[ "$(v STUB_DOT_CLAUDE_WRITE 0)" == 1 ]]; then
+  printf '{"type":"assistant","message":{"id":"msg-w","content":[{"type":"tool_use","name":"Write","input":{"file_path":".claude/skills/x/SKILL.md","content":"x"}}],"usage":{"input_tokens":1,"output_tokens":1}}}\n'
+fi
+t=1
+while [[ $t -le $turns ]]; do
+  printf '{"type":"assistant","message":{"id":"msg-%s-%d","content":[{"type":"text","text":"turn %d"}],"usage":{"input_tokens":10,"output_tokens":%d,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}}\n' \
+    "$phase" "$t" "$t" "$out_tok"
+  if [[ "$(v STUB_SELF_KILL 0)" == 1 && $t -eq 1 ]]; then kill -TERM $$; sleep 5; fi
+  [[ "${STUB_TURN_SLEEP:-0}" != 0 ]] && sleep "$STUB_TURN_SLEEP"
+  t=$((t + 1))
+done
+s="$(v STUB_SLEEP 0)"; [[ "$s" != 0 ]] && sleep "$s"
+printf '{"type":"result","subtype":"success","is_error":false,"session_id":"%s","duration_ms":1000,"num_turns":%d,"total_cost_usd":%s,"usage":{"input_tokens":%d,"output_tokens":%d,"cache_read_input_tokens":3,"cache_creation_input_tokens":4},"modelUsage":{"%s":{"inputTokens":%d,"outputTokens":%d,"costUSD":%s}}}\n' \
+  "$sid" "$turns" "$cost" $((turns * 10)) $((turns * out_tok)) "$used" $((turns * 10)) $((turns * out_tok)) "$cost"
+exit "$(v STUB_EXIT 0)"
diff --git a/evals/tests/fixtures/docker-stub.sh b/evals/tests/fixtures/docker-stub.sh
new file mode 100755
index 00000000..6b0db9e6
--- /dev/null
+++ b/evals/tests/fixtures/docker-stub.sh
@@ -0,0 +1,75 @@
+#!/usr/bin/env bash
+# docker-stub.sh — stand-in for the docker 26.1 CLI in evals/tests/pipeline-run.bats.
+#   docker image inspect --format … <img>  prints $DOCKER_STUB_IMAGE_ID (default
+#                                         sha256:feedface…); exit 1 when
+#                                         DOCKER_STUB_NO_IMAGE=1
+#   docker kill …                         records and exits 0
+#   (each -v spec and, for the non-/workspace mounts, every path under its source go
+#    to $DOCKER_STUB_LOG/run-<n>.mounts)
+#   docker run <flags> <image> <cmd…>     records argv (NUL-separated) to
+#                                         $DOCKER_STUB_LOG/run-<n>.argv, then runs
+#                                         <cmd…> on the host: /workspace in args and
+#                                         env values maps to the -v source of
+#                                         every mount (/workspace, /home/evaluser),
+#                                         the environment is exactly the -e set
+#                                         (bare `-e KEY` takes the client's value),
+#                                         the command word `claude` maps to
+#                                         $DOCKER_STUB_CLAUDE
+set -euo pipefail
+log="${DOCKER_STUB_LOG:-/dev/null}"
+case "${1:-}" in
+  --version) echo "Docker version 26.1.5 (stub)"; exit 0 ;;
+  image)
+    [[ "${DOCKER_STUB_NO_IMAGE:-0}" == 1 ]] && { echo "Error: No such image" >&2; exit 1; }
+    echo "${DOCKER_STUB_IMAGE_ID:-sha256:feedfacefeedfacefeedfacefeedfacefeedfacefeedfacefeedfacefeedface}"; exit 0 ;;
+  kill) [[ "$log" != /dev/null ]] && printf '%s\n' "$*" >> "$log/kill.log"; exit 0 ;;
+  run) shift ;;
+  *) echo "docker-stub: unsupported: $*" >&2; exit 2 ;;
+esac
+if [[ "$log" != /dev/null ]]; then
+  mkdir -p "$log"; n=1; while [[ -e "$log/run-$n.argv" ]]; do n=$((n + 1)); done
+  printf '%s\0' run "$@" > "$log/run-$n.argv"
+fi
+ws="" wd="/"
+mounts=() envs=()
+# flags that take a value (docker 26.1 run); everything else before the image is boolean
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    -v|--volume)
+      src="${2%%:*}" rest="${2#*:}"; dst="${rest%%:*}"; [[ "$dst" == /workspace ]] && ws="$src"
+      mounts+=("$dst=$src")
+      # record each mount and, for the non-/workspace mounts, every path under its source
+      if [[ "$log" != /dev/null ]]; then
+        { printf '%s\n' "$2"
+          if [[ "$dst" != /workspace ]]; then (cd "$src" && find . -mindepth 1 | sed 's|^\./|  |' | LC_ALL=C sort); fi
+        } >> "$log/run-$n.mounts"
+      fi
+      shift 2 ;;
+    -e|--env)
+      # KEY=value as given; a bare KEY takes the client's own value (how secrets travel)
+      if [[ "$2" == *=* ]]; then envs+=("$2"); elif [[ -n "${!2+x}" ]]; then envs+=("$2=${!2}"); fi
+      shift 2 ;;
+    -w|--workdir) wd="$2"; shift 2 ;;
+    --name|--user|--network|--tmpfs|--pids-limit|--memory|--cpus) shift 2 ;;
+    --rm|--read-only|-i|-t) shift ;;
+    -*) echo "docker-stub: unknown flag $1" >&2; exit 2 ;;
+    *) break ;;
+  esac
+done
+shift   # the image
+[[ -n "$ws" ]] || { echo "docker-stub: no /workspace mount" >&2; exit 2; }
+map() {  # container path → host path, for every mount
+  local s="$1" m dst src
+  for m in "${mounts[@]}"; do dst="${m%%=*}" src="${m#*=}"; s="${s//$dst/$src}"; done
+  printf '%s' "$s"
+}
+cmd=() menv=()
+for a in "$@"; do
+  a="$(map "$a")"
+  [[ "$a" == claude ]] && a="${DOCKER_STUB_CLAUDE:?DOCKER_STUB_CLAUDE unset}"
+  cmd+=("$a")
+done
+for e in ${envs[@]+"${envs[@]}"}; do menv+=("${e%%=*}=$(map "${e#*=}")"); done
+cd "$(map "$wd")"
+# the container's environment is exactly the -e set (plus nothing from this host)
+exec env -i ${menv[@]+"${menv[@]}"} "${cmd[@]}"
diff --git a/evals/tests/fixtures/mount-lib-stub.sh b/evals/tests/fixtures/mount-lib-stub.sh
new file mode 100755
index 00000000..567747c7
--- /dev/null
+++ b/evals/tests/fixtures/mount-lib-stub.sh
@@ -0,0 +1,116 @@
+#!/usr/bin/env bash
+# mount-lib-stub.sh — test stand-in for implementer B's evals/harness/lib/sandbox-mount.sh
+# (cycle-130 Sprint 258). pipeline-run.sh sources lib/sandbox-mount.sh by a literal
+# path; pipeline-run.bats (make_harness) and ablation-runs/regen.sh run a temporary
+# copy of the harness with THIS file in that place. Same function names, signatures
+# and return codes as B's contract (0 ok, 2 refused); evidence `key=value` lines go
+# to stdout (the driver appends them to $ARM_EVIDENCE_FILE); the gates toggle writes
+# LOA_ADVERSARIAL_REVIEW_ENFORCE=false to $ARM_ENV_FILE as B's library does. The
+# behaviour is deliberately small: copy the prompt tree's .claude/, CLAUDE.md and
+# .loa.config.yaml; apply the toggles the tests check; hash .claude/ with hashlib.
+#   STUB_MOUNT_FAIL=<fn>   make that function return 2 (infrastructure path)
+#   STUB_BRIEF_EXTRA=<s>   appended to task-brief.md (leak-guard cases)
+#   STUB_ARM_ENV_EXTRA=<l> an extra line written to $ARM_ENV_FILE (env filter case)
+
+_stub_fail() { [[ "${STUB_MOUNT_FAIL:-}" == "$1" ]] && { echo "stub: $1 refused" >&2; return 0; }; return 1; }
+
+mount_prompt_surface() {  # <ws> <prompt_tree> <skill|->
+  _stub_fail mount_prompt_surface && return 2
+  local ws="$1" tree="$2"
+  [[ -d "$tree/.claude" ]] || { echo "stub: no .claude in $tree" >&2; return 2; }
+  cp -a "$tree/.claude" "$ws/.claude"
+  printf '@.claude/loa/CLAUDE.loa.md\n' > "$ws/CLAUDE.md"
+  [[ -f "$tree/.loa.config.yaml" ]] && cp "$tree/.loa.config.yaml" "$ws/.loa.config.yaml"
+  echo "mount=whole_tree"
+}
+
+resolve_arm_toggles() {  # <arm> <suite_file>
+  _stub_fail resolve_arm_toggles && return 2
+  local def
+  def="$(ARM="$1" yq -o=json '.arms[] | select(.id == env(ARM))' "$2" 2>/dev/null)"
+  [[ -n "$def" ]] || { echo "stub: arm $1 undeclared" >&2; return 2; }
+  [[ "$(jq -r '.absent // false' <<<"$def")" == true ]] && { echo "stub: arm $1 absent" >&2; return 2; }
+  jq -c '.toggles // {}' <<<"$def"
+}
+
+apply_arm_toggles() {  # <ws> <toggles_json> <arm>
+  _stub_fail apply_arm_toggles && return 2
+  local ws="$1" tg="$2" cfg="$1/.loa.config.yaml" f n=0 e
+  if [[ "$(jq -r '.companion_voice' <<<"$tg")" == false ]]; then
+    yq -i '.flatline_protocol.code_review.companion_voice = false | .flatline_protocol.security_audit.companion_voice = false' "$cfg"
+    echo "companion_voice=false"
+  fi
+  if [[ "$(jq -r '.gates' <<<"$tg")" == false ]]; then
+    yq -i '.flatline_protocol.code_review.enabled = false | .flatline_protocol.security_audit.enabled = false' "$cfg"
+    echo "gates=false"; echo "arm_env=LOA_ADVERSARIAL_REVIEW_ENFORCE=false"
+    [[ -n "${ARM_ENV_FILE:-}" ]] && echo "LOA_ADVERSARIAL_REVIEW_ENFORCE=false" >> "$ARM_ENV_FILE"
+  fi
+  if [[ "$(jq -r '.flatline' <<<"$tg")" == false ]]; then
+    yq -i '.flatline_protocol.enabled = false' "$cfg"; echo "flatline=false"
+  fi
+  e="$(jq -r '.effort // empty' <<<"$tg")"
+  if [[ -n "$e" ]]; then
+    for f in "$ws"/.claude/skills/*/SKILL.md; do
+      [[ -f "$f" ]] || continue
+      # frontmatter only (between the first two --- lines), as B's library does
+      awk 'NR == 1 {fm = ($0 == "---")} NR > 1 && fm && $0 == "---" {fm = 0; print; next} fm && NR > 1 && /^effort:/ {next} {print}' \
+        "$f" > "$f.tmp" && mv "$f.tmp" "$f"; n=$((n + 1))
+    done
+    echo "effort=$e"; echo "effort_stripped=$n"
+  fi
+  [[ "$(jq -r '.loa_mount' <<<"$tg")" == false ]] && echo "loa_mount=none"
+  [[ -n "${STUB_ARM_ENV_EXTRA:-}" && -n "${ARM_ENV_FILE:-}" ]] && printf '%s\n' "$STUB_ARM_ENV_EXTRA" >> "$ARM_ENV_FILE"
+  return 0
+}
+
+regen_sandbox_manifest() {  # <ws>
+  _stub_fail regen_sandbox_manifest && return 2
+  python3 -I -c '
+import hashlib, json, os, sys
+ws = sys.argv[1]
+files = {}
+for d, _, names in os.walk(os.path.join(ws, ".claude")):
+    for n in names:
+        p = os.path.join(d, n); rel = os.path.relpath(p, ws)
+        if rel == ".claude/checksums.json" or rel.startswith(".claude/overrides/"):
+            continue
+        files[rel] = hashlib.sha256(open(p, "rb").read()).hexdigest()
+man = os.path.join(ws, ".claude", "checksums.json")
+with open(man, "w") as f:
+    json.dump({"generated": "stub", "algorithm": "sha256", "files": dict(sorted(files.items()))}, f, indent=2)
+print("manifest_files=%d" % len(files))
+print("manifest_sha256=" + hashlib.sha256(open(man, "rb").read()).hexdigest())' "$1"
+}
+
+check_fixture_path_rule() {  # <fixture_dir>
+  _stub_fail check_fixture_path_rule && return 2
+  local d="$1" p bad=0
+  for p in .claude CLAUDE.md .loa.config.yaml grimoires .run; do
+    [[ -e "$d/$p" ]] && { echo "fixture path rule: $p" >&2; bad=1; }
+  done
+  [[ $bad -eq 0 ]] || return 2
+  return 0
+}
+
+write_sandbox_grimoire() {  # <ws> <task_yaml> <arm> <sprint_label>
+  _stub_fail write_sandbox_grimoire && return 2
+  local ws="$1" ty="$2" arm="$3" sp="$4" g="$1/grimoires/loa" type
+  mkdir -p "$g/context" "$g/a2a/$sp"
+  printf '{"cycles":[{"id":"cycle-eval","status":"active","sprints":[{"local":"%s","status":"planned"}]}]}\n' "$sp" > "$g/ledger.json"
+  printf '# NOTES\n' > "$g/NOTES.md"
+  { printf '# Task brief\n\n%s\n' "$(yq -r '.criterion // ""' "$ty")"
+    [[ -f "$(dirname "$ty")/TASK.md" ]] && cat "$(dirname "$ty")/TASK.md"
+    [[ -n "${STUB_BRIEF_EXTRA:-}" ]] && printf '%s\n' "$STUB_BRIEF_EXTRA"
+  } > "$g/context/task-brief.md"
+  type="$(yq -r '.type' "$ty")"
+  if [[ "$type" == review-catch ]]; then
+    printf '# Sprint plan\n\n## %s\nReview the change in pr/head.diff.\n' "$sp" > "$g/sprint.md"
+    cp "$ws/pr/PR.md" "$g/a2a/$sp/reviewer.md" 2>/dev/null || true
+  fi
+  return 0
+}
+
+init_sandbox_beads() {  # <ws> <task_title>
+  _stub_fail init_sandbox_beads && return 2
+  echo "beads=opt-out"
+}
diff --git a/evals/tests/freeze.bats b/evals/tests/freeze.bats
new file mode 100644
index 00000000..6fac1061
--- /dev/null
+++ b/evals/tests/freeze.bats
@@ -0,0 +1,101 @@
+#!/usr/bin/env bats
+# =============================================================================
+# evals/tests/freeze.bats — cycle-130 Sprint 258 Task 1.11 (PRD AC-5.1, sprint
+# AC-1.13, SDD §5.13, DEC-0414)
+#
+# freeze.sh writes MANIFEST.sha256 over every file under tasks/ (smoke/ with
+# --smoke) after validate-suite.sh passes; --check recomputes and fails on any
+# drift, one changed byte included, naming the path.
+# =============================================================================
+
+setup() {
+  TESTS_DIR="$(cd "$(dirname "$BATS_TEST_FILENAME")" && pwd)"
+  REPO_ROOT="$(cd "$TESTS_DIR/../.." && pwd)"
+  FZ="$REPO_ROOT/evals/harness/freeze.sh"
+  T="$(mktemp -d "${BATS_TEST_TMPDIR:-/tmp}/fz.XXXXXX")"
+  R="$T/suite"; mkdir -p "$R"
+  export LOA_EVAL_PHASE_PROMPTS_DIR="$T/no-prompts"
+  # shellcheck source=fixtures/ablation/suite-lib.bash
+  source "$TESTS_DIR/fixtures/ablation/suite-lib.bash"
+  # shellcheck source=../../.claude/scripts/compat-lib.sh
+  source "$REPO_ROOT/.claude/scripts/compat-lib.sh"
+  make_task "$R" tasks bug-fix-01 bug-fix
+  make_task "$R" tasks review-catch-01 review-catch
+}
+
+teardown() {
+  find "$T" -mindepth 1 -delete 2>/dev/null || true
+  rmdir "$T" 2>/dev/null || true
+}
+
+@test "FZ-1 freeze writes one sorted '<sha256>  <relpath>' line per file under tasks/; --check then passes" {
+  run "$FZ" --root "$R" --allow-partial
+  [ "$status" -eq 0 ]
+  grep -q '^freeze: wrote MANIFEST.sha256 (' <<<"$output"
+  M="$R/MANIFEST.sha256"
+  [ "$(grep -c . "$M")" -eq "$(cd "$R" && find tasks -type f | wc -l | tr -d ' ')" ]
+  [ "$(awk '{print $2}' "$M")" = "$(awk '{print $2}' "$M" | LC_ALL=C sort)" ]
+  ! grep -qv '^[0-9a-f]\{64\}  tasks/' "$M"
+  want="$(cd "$R" && sha256_portable tasks/bug-fix-01/task.yaml)"
+  grep -qxF "$want" "$M"
+  run "$FZ" --root "$R" --allow-partial --check
+  [ "$status" -eq 0 ]
+  grep -q '^freeze: OK — ' <<<"$output"
+}
+
+@test "FZ-2 one changed byte under tasks/ is drift: --check exits 1 and names the path; added and removed files too" {
+  "$FZ" --root "$R" --allow-partial >/dev/null
+  f="$R/tasks/bug-fix-01/hidden/tests/test_slug.py"
+  printf 'X' | dd of="$f" bs=1 seek=0 count=1 conv=notrunc 2>/dev/null
+  run "$FZ" --root "$R" --allow-partial --check
+  [ "$status" -eq 1 ]
+  grep -q 'changed  tasks/bug-fix-01/hidden/tests/test_slug.py' <<<"$output"
+  "$FZ" --root "$R" --allow-partial >/dev/null
+  echo extra > "$R/tasks/bug-fix-01/hidden/tests/extra.txt"
+  run "$FZ" --root "$R" --allow-partial --check
+  [ "$status" -eq 1 ]
+  grep -q 'added    tasks/bug-fix-01/hidden/tests/extra.txt' <<<"$output"
+  rm "$R/tasks/bug-fix-01/hidden/tests/extra.txt"
+  "$FZ" --root "$R" --allow-partial >/dev/null
+  rm "$R/tasks/bug-fix-01/hidden/reference.patch"
+  yq -i '.reference_patch = null | .type = "refactor" | .structural_check = "hidden/tests/test_slug.py"' "$R/tasks/bug-fix-01/task.yaml"
+  run "$FZ" --root "$R" --allow-partial --check
+  [ "$status" -eq 1 ]
+  grep -q 'removed  tasks/bug-fix-01/hidden/reference.patch' <<<"$output"
+  grep -q 'changed  tasks/bug-fix-01/task.yaml' <<<"$output"
+}
+
+@test "FZ-3 an invalid suite is never frozen: exit 1, no manifest written" {
+  echo "uses hidden tests" >> "$R/tasks/bug-fix-01/TASK.md"
+  run "$FZ" --root "$R" --allow-partial
+  [ "$status" -eq 1 ]
+  grep -q 'refused — the suite does not validate' <<<"$output"
+  [ ! -e "$R/MANIFEST.sha256" ]
+}
+
+@test "FZ-4 --smoke covers smoke/; without it smoke files are outside the manifest" {
+  make_task "$R" smoke smoke-x bug-fix
+  "$FZ" --root "$R" --allow-partial >/dev/null
+  ! grep -q '  smoke/' "$R/MANIFEST.sha256"
+  "$FZ" --root "$R" --allow-partial --smoke >/dev/null
+  grep -q '  smoke/smoke-x/task.yaml$' "$R/MANIFEST.sha256"
+  echo y >> "$R/smoke/smoke-x/fixture/src/textkit/__init__.py"
+  run "$FZ" --root "$R" --allow-partial --smoke --check
+  [ "$status" -eq 1 ]
+  grep -q 'changed  smoke/smoke-x/fixture/src/textkit/__init__.py' <<<"$output"
+}
+
+@test "FZ-5 --check without a manifest is exit 1; usage errors are exit 2" {
+  run "$FZ" --root "$R" --allow-partial --check
+  [ "$status" -eq 1 ]
+  grep -q 'no MANIFEST.sha256' <<<"$output"
+  run "$FZ" --bogus
+  [ "$status" -eq 2 ]
+  run "$FZ" --root "$T/absent"
+  [ "$status" -eq 2 ]
+}
+
