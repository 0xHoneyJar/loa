+  S="$B/STATUS.json"
+  [ "$(jq -r '.state' "$S")" = complete ]
+  jq -e '.drift == null' "$S" >/dev/null
+  [ "$(jq -r '.drift_cleared | length' "$S")" = 1 ]
+  [ "$(jq -r '.drift_cleared[0].run_id' "$S")" = "$x" ]
+  [ "$(jq -r '.drift_cleared[0].previous.field' "$S")" = models_used.FIX2 ]
