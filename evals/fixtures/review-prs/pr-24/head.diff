+  ra --batch cd2 --resume --clear-drift
+  [ "$status" -eq 2 ]; grep -q 'still drifts under the current rule' <<<"$output"
+  cmp "$RES/cd2/STATUS.json" "$T/st2.before"
+  cmp "$RES/runs.jsonl" "$T/rows2.before"
