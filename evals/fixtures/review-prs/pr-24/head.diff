+  jq --arg r "$x" '.state = "failed" | .drift = {run_id: $r, field: "models_used.FIX2", expected: ["claude-fable-5-1", "claude-opus-5-5"],
+                    got: "global.anthropic.claude-haiku-4-5-20251001-v1:0"}' "$B/STATUS.json" > "$T/st" && mv "$T/st" "$B/STATUS.json"
