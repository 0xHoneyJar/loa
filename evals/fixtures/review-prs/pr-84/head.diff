@@ -0,0 +1,12 @@
+---
+"@biomejs/biome": patch
+---
+
+Fixed the formatter removing the parentheses around an instantiation expression before a non-null assertion or type arguments of a class heritage, which produced code that doesn't parse.
+
+```diff
+- const a = make<T>!;
++ const a = (make<T>)!;
+- class D extends B<T><T> {}
++ class D extends (B<T>)<T> {}
+```
diff --git a/crates/biome_js_formatter/tests/specs/ts/expression/instantiation_expression_non_null.ts b/crates/biome_js_formatter/tests/specs/ts/expression/instantiation_expression_non_null.ts
new file mode 100644
index 0000000000..b1422d5f37
--- /dev/null
+++ b/crates/biome_js_formatter/tests/specs/ts/expression/instantiation_expression_non_null.ts
@@ -0,0 +1,11 @@
+// Without the parentheses, `make<T>!` and `extends B<T><T>` don't parse.
+const a = (make<T>)!;
+(make<T>)!.b;
+(make<T>)!();
+y = (make<T>)!.c<U>;
+class D extends (B<T>)<T> {}
+(class E extends (B<T>)<T> {});
+
+// These don't need them.
+class C extends (B<T>) {}
+x = make<T>;
