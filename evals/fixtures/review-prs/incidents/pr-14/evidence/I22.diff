+        j, depth = h, 0
+        while j <= end:
+            t = re.sub(r"#.*$", "", lines[j - 1])
+            depth += t.count("(") - t.count(")")
+            if depth <= 0 and t.rstrip().endswith(":"):
+                break
+            j += 1
+        last = j
+        for L in range(j + 1, end + 1):
             t = lines[L - 1]
             if not t.strip() or t.lstrip().startswith("#"):
