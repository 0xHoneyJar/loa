+  man_s '[{"id":"S1","file":".claude/scripts/sig.py","anchor_line":6,"severity":"medium"}]'
+  review 'sig.py:12 the return'
+  run "$GRADER" "$WS" pr-s
+  [ "$status" -eq 0 ]
+  [ "$(D '.details.detected | join(",")')" = "S1" ]
+  review 'sig.py:14 the next def'
+  run "$GRADER" "$WS" pr-s
+  [ "$(D '.details.detected | length')" = "0" ]
+}
